---
import Layout from '../../layouts/Layout.astro';
import ResearchHeader from '../../components/ResearchHeader.astro';
import siteData from '../../data/potbelly-sites.json';
import 'leaflet/dist/leaflet.css';

type PotbellyCountry = 'El Salvador' | 'Guatemala' | 'Honduras' | 'Mexico';

interface PotbellySiteProperties {
  fid: string;
  site_id: string;
  site_name: string;
  country: PotbellyCountry;
  n_monuments: string;
  location_precision: string;
  latitude: number;
  longitude: number;
}

interface PotbellySiteFeature {
  type: 'Feature';
  properties: PotbellySiteProperties;
  geometry: {
    type: 'Point';
    coordinates: [number, number];
  };
}

interface PotbellySiteCollection {
  type: 'FeatureCollection';
  features: PotbellySiteFeature[];
}

const siteCollection = siteData as unknown as PotbellySiteCollection;
const sites = siteCollection.features;
const validCountries = new Set<PotbellyCountry>(['El Salvador', 'Guatemala', 'Honduras', 'Mexico']);
const seenSiteIds = new Set<string>();

sites.forEach((feature, index) => {
  const site = feature.properties;
  const invalid =
    feature.type !== 'Feature' ||
    feature.geometry.type !== 'Point' ||
    feature.geometry.coordinates.length !== 2 ||
    !site.site_id ||
    !site.site_name ||
    !site.location_precision ||
    !validCountries.has(site.country) ||
    !Number.isFinite(Number(site.n_monuments)) ||
    !Number.isFinite(site.latitude) ||
    !Number.isFinite(site.longitude) ||
    !Number.isFinite(feature.geometry.coordinates[0]) ||
    !Number.isFinite(feature.geometry.coordinates[1]) ||
    seenSiteIds.has(site.site_id);

  if (invalid) {
    throw new Error(`Invalid Potbelly GIS record: ${site.site_id || index}`);
  }
  seenSiteIds.add(site.site_id);
});

const initialSite = sites[0].properties;
const numberFormatter = new Intl.NumberFormat('en-US');
const totalMonuments = sites.reduce((total, feature) => total + Number(feature.properties.n_monuments), 0);
const countryCount = new Set(sites.map((feature) => feature.properties.country)).size;
const formatNumber = (value: number) => numberFormatter.format(value);
const formatCoordinates = (site: PotbellySiteProperties) => `${site.latitude.toFixed(4)}, ${site.longitude.toFixed(4)}`;
const countrySlug = (country: PotbellyCountry) => country.toLowerCase().replaceAll(' ', '-');
const monumentLabel = (count: number) => `${formatNumber(count)} ${count === 1 ? 'monument' : 'monuments'}`;
---

<Layout
  title="GIS Database — Preclassic Maya Potbelly Sculptures — Center for Mesoamerican Studies"
  description="Search and explore 43 recorded Preclassic Maya potbelly sculpture sites across Mesoamerica."
  bodyClass="potbelly-gis-page"
>
  <div class="gis-shell" data-potbelly-gis>
    <ResearchHeader currentHref="/grants-and-investigations" />

    <a class="gis-origin" href="/grants-and-investigations#potbelly-sculptures-project">
      <span aria-hidden="true">&larr;</span>
      Back to original project
    </a>

    <header class="gis-intro">
      <div class="gis-title-group">
        <p class="gis-project-id">09I03-03-V04-00234</p>
        <h2>GIS Database</h2>
      </div>

      <div class="gis-intro-copy">
        <p>
          Explore {sites.length} recorded sites documenting {formatNumber(totalMonuments)} potbelly monuments across Mexico, Guatemala, El Salvador, and Honduras. Search the catalogue or select a marker to inspect each location and the precision of its coordinates.
        </p>

        <dl class="gis-summary" aria-label="Database summary">
          <div>
            <dt>Sites</dt>
            <dd>{formatNumber(sites.length)}</dd>
          </div>
          <div>
            <dt>Recorded monuments</dt>
            <dd>{formatNumber(totalMonuments)}</dd>
          </div>
          <div>
            <dt>Countries</dt>
            <dd>{formatNumber(countryCount)}</dd>
          </div>
        </dl>
      </div>
    </header>

    <section class="gis-workspace" aria-label="Potbelly sculpture site database">
      <article class="gis-map-panel" data-map-panel aria-labelledby="gis-map-title">
        <header class="gis-map-bar">
          <div>
            <p>Geographic catalogue</p>
            <h3 id="gis-map-title">Explore recorded sites</h3>
          </div>

          <div class="gis-map-actions">
            <button type="button" data-reset-extent>
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="M4 9V4h5M20 15v5h-5M20 9V4h-5M4 15v5h5"></path>
              </svg>
              <span>Reset extent</span>
            </button>
            <button type="button" data-toggle-fullscreen aria-label="Enter fullscreen">
              <svg data-fullscreen-enter-icon aria-hidden="true" viewBox="0 0 24 24">
                <path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5"></path>
              </svg>
              <svg class="is-hidden" data-fullscreen-exit-icon aria-hidden="true" viewBox="0 0 24 24">
                <path d="M3 8h5V3M21 8h-5V3M3 16h5v5M21 16h-5v5"></path>
              </svg>
              <span data-fullscreen-label>Fullscreen</span>
            </button>
          </div>
        </header>

        <p class="gis-map-instructions" id="gis-map-instructions">
          Drag to pan, scroll or use the controls to zoom, and select a marker for its record.
        </p>

        <div
          class="gis-map"
          id="potbelly-map"
          data-gis-map
          aria-label="Interactive map of recorded potbelly sculpture sites"
          aria-describedby="gis-map-instructions"
        ></div>

        <footer class="gis-map-footer">
          <div class="gis-legend" aria-label="Recorded monument marker scale">
            <span class="gis-legend-title">Recorded monuments</span>
            <ol>
              <li><span class="gis-legend-dot marker-bin-1" aria-hidden="true"></span><span>1</span></li>
              <li><span class="gis-legend-dot marker-bin-2" aria-hidden="true"></span><span>2–3</span></li>
              <li><span class="gis-legend-dot marker-bin-3" aria-hidden="true"></span><span>4–6</span></li>
              <li><span class="gis-legend-dot marker-bin-4" aria-hidden="true"></span><span>7–11</span></li>
              <li><span class="gis-legend-dot marker-bin-5" aria-hidden="true"></span><span>12–17</span></li>
            </ol>
            <span class="gis-legend-note">Circle size and tone represent recorded monuments.</span>
          </div>
          <p class="gis-map-status" data-map-status role="status">Loading geographic context…</p>
        </footer>
      </article>

      <aside class="gis-catalogue" aria-label="Browse site records">
        <section class="gis-selected-site" id="potbelly-site-details" aria-labelledby="selected-site-title">
          <div class="gis-selected-heading">
            <div>
              <p>Selected site</p>
              <span class="gis-selected-code" data-selected-id>{initialSite.site_id}</span>
              <h3 id="selected-site-title" data-selected-name>{initialSite.site_name}</h3>
            </div>
            <div class="gis-selected-actions">
              <button type="button" data-copy-site-link>Copy site link</button>
              <button type="button" data-center-site>Center on map</button>
            </div>
          </div>

          <dl class="gis-site-facts">
            <div>
              <dt>Country</dt>
              <dd data-selected-country>{initialSite.country}</dd>
            </div>
            <div>
              <dt>Recorded monuments</dt>
              <dd data-selected-monuments>{formatNumber(Number(initialSite.n_monuments))}</dd>
            </div>
            <div class="gis-fact-wide">
              <dt>Location precision</dt>
              <dd data-selected-precision>{initialSite.location_precision}</dd>
            </div>
            <div class="gis-fact-wide">
              <dt>Coordinates</dt>
              <dd data-selected-coordinates>{formatCoordinates(initialSite)}</dd>
            </div>
          </dl>
          <p class="visually-hidden" data-selection-status role="status"></p>
        </section>

        <form class="gis-catalogue-controls" role="search" data-catalogue-controls>
          <div class="gis-control gis-control-search">
            <label for="gis-site-search">Search sites</label>
            <input
              id="gis-site-search"
              type="search"
              name="q"
              placeholder="Site, country, or record ID…"
              autocomplete="off"
              spellcheck="false"
              data-site-search
            />
          </div>

          <div class="gis-control">
            <label for="gis-country-filter">Country</label>
            <select id="gis-country-filter" name="country" autocomplete="off" data-country-filter>
              <option value="all">All countries</option>
              <option value="mexico">Mexico</option>
              <option value="guatemala">Guatemala</option>
              <option value="el-salvador">El Salvador</option>
              <option value="honduras">Honduras</option>
            </select>
          </div>
        </form>

        <p class="gis-results-count" data-results-count aria-live="polite">{sites.length} sites</p>

        <div class="gis-site-list-scroll">
          <ol class="gis-site-list" data-site-list>
            {sites.map((feature, index) => {
              const site = feature.properties;
              const count = Number(site.n_monuments);
              return (
                <li
                  data-site-item
                  data-site-id={site.site_id}
                  data-country={countrySlug(site.country)}
                  data-search={`${site.site_id} ${site.site_name} ${site.country} ${site.location_precision}`.toLowerCase()}
                >
                  <button
                    type="button"
                    class:list={['gis-site-button', { 'is-selected': index === 0 }]}
                    aria-label={`View ${site.site_id}: ${site.site_name}`}
                    aria-controls="potbelly-site-details"
                    aria-pressed={index === 0 ? 'true' : 'false'}
                    data-select-site
                    data-site-id={site.site_id}
                  >
                    <span class="gis-site-copy">
                      <span class="gis-site-code">{site.site_id}</span>
                      <span class="gis-site-name">{site.site_name}</span>
                      <span class="gis-site-meta">{site.country} · {monumentLabel(count)}</span>
                    </span>
                    <span class="gis-site-action" aria-hidden="true">View</span>
                  </button>
                </li>
              );
            })}
          </ol>

          <div class="gis-empty-state" data-empty-state hidden>
            <p>No sites match this search and country filter.</p>
            <button type="button" data-clear-filters>Clear filters</button>
          </div>
        </div>
      </aside>
    </section>

    <section class="gis-about" aria-labelledby="gis-about-title">
      <p>Database scope</p>
      <h3 id="gis-about-title">About the records</h3>
      <p>
        This map reproduces the site names, coordinates, monument counts, and location-precision notes supplied by the Preclassic Maya Potbelly Sculptures project. Circle size represents recorded monuments; country boundaries provide geographic context only.
      </p>
    </section>
  </div>
</Layout>

<script>
  import * as L from 'leaflet';
  import siteData from '../../data/potbelly-sites.json';

  type PotbellyCountry = 'El Salvador' | 'Guatemala' | 'Honduras' | 'Mexico';

  interface PotbellySiteProperties {
    fid: string;
    site_id: string;
    site_name: string;
    country: PotbellyCountry;
    n_monuments: string;
    location_precision: string;
    latitude: number;
    longitude: number;
  }

  interface PotbellySiteFeature {
    type: 'Feature';
    properties: PotbellySiteProperties;
    geometry: {
      type: 'Point';
      coordinates: [number, number];
    };
  }

  interface PotbellySiteCollection {
    type: 'FeatureCollection';
    features: PotbellySiteFeature[];
  }

  const clientSites = (siteData as unknown as PotbellySiteCollection).features;
  const clientSiteById = new Map(clientSites.map((feature) => [feature.properties.site_id, feature]));
  let activeGisMap: L.Map | null = null;

  const countryBySlug: Record<string, PotbellyCountry> = {
    mexico: 'Mexico',
    guatemala: 'Guatemala',
    'el-salvador': 'El Salvador',
    honduras: 'Honduras',
  };

  const markerBin = (count: number) => {
    if (count <= 1) return 1;
    if (count <= 3) return 2;
    if (count <= 6) return 3;
    if (count <= 11) return 4;
    return 5;
  };

  const formatCoordinates = (site: PotbellySiteProperties) => `${site.latitude.toFixed(4)}, ${site.longitude.toFixed(4)}`;
  const pluralizedMonuments = (count: number) => `${count} recorded ${count === 1 ? 'monument' : 'monuments'}`;
  const escapeHtml = (value: string) => value.replace(/[&<>'"]/g, (character) => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    "'": '&#39;',
    '"': '&quot;',
  })[character] || character);

  async function initPotbellyGisDatabase(): Promise<void> {
    const root = document.querySelector<HTMLElement>('[data-potbelly-gis]');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const mapElement = root.querySelector<HTMLElement>('[data-gis-map]');
    const mapPanel = root.querySelector<HTMLElement>('[data-map-panel]');
    const mapStatus = root.querySelector<HTMLElement>('[data-map-status]');
    const resetExtentButton = root.querySelector<HTMLButtonElement>('[data-reset-extent]');
    const fullscreenButton = root.querySelector<HTMLButtonElement>('[data-toggle-fullscreen]');
    const fullscreenLabel = root.querySelector<HTMLElement>('[data-fullscreen-label]');
    const fullscreenEnterIcon = root.querySelector<SVGElement>('[data-fullscreen-enter-icon]');
    const fullscreenExitIcon = root.querySelector<SVGElement>('[data-fullscreen-exit-icon]');
    const selectedPanel = root.querySelector<HTMLElement>('.gis-selected-site');
    const selectedId = root.querySelector<HTMLElement>('[data-selected-id]');
    const selectedName = root.querySelector<HTMLElement>('[data-selected-name]');
    const selectedCountry = root.querySelector<HTMLElement>('[data-selected-country]');
    const selectedMonuments = root.querySelector<HTMLElement>('[data-selected-monuments]');
    const selectedPrecision = root.querySelector<HTMLElement>('[data-selected-precision]');
    const selectedCoordinates = root.querySelector<HTMLElement>('[data-selected-coordinates]');
    const selectionStatus = root.querySelector<HTMLElement>('[data-selection-status]');
    const copySiteLinkButton = root.querySelector<HTMLButtonElement>('[data-copy-site-link]');
    const centerSiteButton = root.querySelector<HTMLButtonElement>('[data-center-site]');
    const searchInput = root.querySelector<HTMLInputElement>('[data-site-search]');
    const countrySelect = root.querySelector<HTMLSelectElement>('[data-country-filter]');
    const resultsCount = root.querySelector<HTMLElement>('[data-results-count]');
    const emptyState = root.querySelector<HTMLElement>('[data-empty-state]');
    const clearFiltersButton = root.querySelector<HTMLButtonElement>('[data-clear-filters]');
    const siteItems = Array.from(root.querySelectorAll<HTMLElement>('[data-site-item]'));
    const siteButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-select-site]'));

    if (
      !mapElement ||
      !mapPanel ||
      !mapStatus ||
      !resetExtentButton ||
      !fullscreenButton ||
      !searchInput ||
      !countrySelect ||
      !resultsCount ||
      !emptyState ||
      !clearFiltersButton ||
      siteButtons.length === 0
    ) return;

    activeGisMap?.remove();
    const map = L.map(mapElement, {
      minZoom: 4,
      maxZoom: 10,
      zoomControl: true,
      attributionControl: true,
    });
    activeGisMap = map;
    L.control.scale({ imperial: false, position: 'bottomleft' }).addTo(map);

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const stackedLayout = window.matchMedia('(max-width: 67.99rem)');
    const siteLayer = L.layerGroup().addTo(map);
    const markerById = new Map<string, L.Marker>();
    const itemById = new Map<string, HTMLElement>();
    const buttonById = new Map<string, HTMLButtonElement>();
    const visibleSiteIds = new Set<string>();
    const countryLabels: L.Marker[] = [];
    let selectedSiteId: string | null = null;
    let initializing = true;

    siteItems.forEach((item) => {
      if (item.dataset.siteId) itemById.set(item.dataset.siteId, item);
    });
    siteButtons.forEach((button) => {
      if (button.dataset.siteId) buttonById.set(button.dataset.siteId, button);
    });

    const setMapStatus = (message: string) => {
      mapStatus.textContent = message;
    };

    const updateMarkerElement = (siteId: string) => {
      const marker = markerById.get(siteId);
      const feature = clientSiteById.get(siteId);
      const element = marker?.getElement();
      if (!marker || !feature || !element) return;
      const site = feature.properties;
      const count = Number(site.n_monuments);
      const selected = selectedSiteId === siteId;

      element.dataset.siteId = siteId;
      element.setAttribute('role', 'button');
      element.setAttribute('tabindex', '0');
      element.setAttribute('aria-label', `${site.site_name}, ${site.country}, ${pluralizedMonuments(count)}`);
      element.setAttribute('aria-pressed', selected ? 'true' : 'false');
      element.classList.toggle('is-selected', selected);
      marker.setZIndexOffset(selected ? 1000 : 0);

      if (element.dataset.gisEventsBound !== 'true') {
        element.dataset.gisEventsBound = 'true';
        element.addEventListener('keydown', (event) => {
          if (event.key !== ' ') return;
          event.preventDefault();
          selectSite(siteId, { moveMap: true, focusDetails: true });
        });
        element.addEventListener('focus', () => marker.openTooltip());
        element.addEventListener('blur', () => marker.closeTooltip());
      }
    };

    clientSites.forEach((feature) => {
      const site = feature.properties;
      const count = Number(site.n_monuments);
      const bin = markerBin(count);
      const marker = L.marker([site.latitude, site.longitude], {
        keyboard: true,
        riseOnHover: true,
        icon: L.divIcon({
          className: 'gis-site-marker-shell',
          html: `<span class="gis-site-marker-dot marker-bin-${bin}" aria-hidden="true"></span>`,
          iconSize: [44, 44],
          iconAnchor: [22, 22],
        }),
      });

      marker.bindTooltip(`${escapeHtml(site.site_name)} · ${count} ${count === 1 ? 'monument' : 'monuments'}`, {
        className: 'gis-site-tooltip',
        direction: 'top',
        offset: [0, -18],
        opacity: 1,
      });
      marker.on('add', () => updateMarkerElement(site.site_id));
      marker.on('click', () => selectSite(site.site_id, { moveMap: true, focusDetails: true }));
      markerById.set(site.site_id, marker);
      visibleSiteIds.add(site.site_id);
      siteLayer.addLayer(marker);
    });

    const syncUrl = () => {
      if (initializing) return;
      const url = new URL(window.location.href);
      const query = searchInput.value.trim();
      const country = countrySelect.value;

      if (query) url.searchParams.set('q', query);
      else url.searchParams.delete('q');
      if (country !== 'all') url.searchParams.set('country', country);
      else url.searchParams.delete('country');
      url.hash = selectedSiteId || '';
      window.history.replaceState(null, '', url);
    };

    const clearSelection = () => {
      selectedSiteId = null;
      siteButtons.forEach((button) => {
        button.classList.remove('is-selected');
        button.setAttribute('aria-pressed', 'false');
      });
      markerById.forEach((_, siteId) => updateMarkerElement(siteId));
      if (selectedPanel) selectedPanel.classList.add('has-no-selection');
      if (selectedId) selectedId.textContent = 'No site selected';
      if (selectedName) selectedName.textContent = 'Select a site';
      if (selectedCountry) selectedCountry.textContent = '—';
      if (selectedMonuments) selectedMonuments.textContent = '—';
      if (selectedPrecision) selectedPrecision.textContent = 'Select one of the matching sites.';
      if (selectedCoordinates) selectedCoordinates.textContent = '—';
      if (copySiteLinkButton) copySiteLinkButton.disabled = true;
      if (centerSiteButton) centerSiteButton.disabled = true;
      syncUrl();
    };

    const selectSite = (
      siteId: string,
      options: { updateUrl?: boolean; moveMap?: boolean; focusDetails?: boolean } = {},
    ) => {
      const feature = clientSiteById.get(siteId);
      if (!feature || !visibleSiteIds.has(siteId)) return;
      const site = feature.properties;
      const count = Number(site.n_monuments);
      const updateUrl = options.updateUrl !== false;
      const moveMap = options.moveMap !== false;
      const focusDetails = options.focusDetails === true;
      selectedSiteId = siteId;

      siteButtons.forEach((button) => {
        const selected = button.dataset.siteId === siteId;
        button.classList.toggle('is-selected', selected);
        button.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });
      markerById.forEach((_, markerSiteId) => updateMarkerElement(markerSiteId));

      if (selectedPanel) selectedPanel.classList.remove('has-no-selection');
      if (selectedId) selectedId.textContent = site.site_id;
      if (selectedName) selectedName.textContent = site.site_name;
      if (selectedCountry) selectedCountry.textContent = site.country;
      if (selectedMonuments) selectedMonuments.textContent = String(count);
      if (selectedPrecision) selectedPrecision.textContent = site.location_precision;
      if (selectedCoordinates) selectedCoordinates.textContent = formatCoordinates(site);
      if (selectionStatus) selectionStatus.textContent = `${site.site_name} selected`;
      if (copySiteLinkButton) copySiteLinkButton.disabled = false;
      if (centerSiteButton) centerSiteButton.disabled = false;

      if (moveMap) {
        const target: L.LatLngExpression = [site.latitude, site.longitude];
        const zoom = Math.max(map.getZoom(), 7);
        if (reducedMotion.matches) map.setView(target, zoom, { animate: false });
        else map.flyTo(target, zoom, { animate: true, duration: 0.45 });
      }

      if (focusDetails && stackedLayout.matches && selectedPanel) {
        selectedPanel.scrollIntoView({
          behavior: reducedMotion.matches ? 'auto' : 'smooth',
          block: 'start',
        });
      }
      if (updateUrl) syncUrl();
    };

    const fitVisibleSites = () => {
      const visibleFeatures = clientSites.filter((feature) => visibleSiteIds.has(feature.properties.site_id));
      if (visibleFeatures.length === 0) return;
      if (visibleFeatures.length === 1) {
        const site = visibleFeatures[0].properties;
        map.setView([site.latitude, site.longitude], 8, { animate: !reducedMotion.matches });
        return;
      }

      const bounds = L.latLngBounds(
        visibleFeatures.map((feature) => [feature.properties.latitude, feature.properties.longitude] as L.LatLngTuple),
      );
      map.fitBounds(bounds, {
        padding: [32, 32],
        maxZoom: 7,
        animate: !reducedMotion.matches,
      });
    };

    const applyFilters = () => {
      const query = searchInput.value.trim().toLowerCase();
      const country = countrySelect.value;
      visibleSiteIds.clear();

      clientSites.forEach((feature) => {
        const site = feature.properties;
        const item = itemById.get(site.site_id);
        const marker = markerById.get(site.site_id);
        const searchText = item?.dataset.search || '';
        const matchesSearch = !query || searchText.includes(query);
        const matchesCountry = country === 'all' || item?.dataset.country === country;
        const visible = matchesSearch && matchesCountry;

        if (item) item.hidden = !visible;
        if (marker) {
          if (visible && !siteLayer.hasLayer(marker)) siteLayer.addLayer(marker);
          if (!visible && siteLayer.hasLayer(marker)) siteLayer.removeLayer(marker);
        }
        if (visible) visibleSiteIds.add(site.site_id);
      });

      const visibleCount = visibleSiteIds.size;
      resultsCount.textContent = `${visibleCount} ${visibleCount === 1 ? 'site' : 'sites'}`;
      emptyState.hidden = visibleCount !== 0;
      if (selectedSiteId && !visibleSiteIds.has(selectedSiteId)) clearSelection();
      syncUrl();
    };

    siteButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const siteId = button.dataset.siteId;
        if (siteId) selectSite(siteId, { moveMap: true, focusDetails: true });
      });
    });

    searchInput.addEventListener('input', () => {
      applyFilters();
      fitVisibleSites();
    });
    countrySelect.addEventListener('change', () => {
      applyFilters();
      fitVisibleSites();
    });
    clearFiltersButton.addEventListener('click', () => {
      searchInput.value = '';
      countrySelect.value = 'all';
      applyFilters();
      selectSite('S001', { updateUrl: false, moveMap: false, focusDetails: false });
      fitVisibleSites();
      syncUrl();
      searchInput.focus();
    });
    resetExtentButton.addEventListener('click', fitVisibleSites);
    centerSiteButton?.addEventListener('click', () => {
      if (selectedSiteId) selectSite(selectedSiteId, { updateUrl: false, moveMap: true, focusDetails: false });
    });
    copySiteLinkButton?.addEventListener('click', async () => {
      if (!selectedSiteId) return;
      const url = new URL(window.location.pathname, window.location.origin);
      url.hash = selectedSiteId;
      try {
        await navigator.clipboard.writeText(url.toString());
        copySiteLinkButton.textContent = 'Link copied';
      } catch {
        copySiteLinkButton.textContent = 'Copy unavailable';
      }
      window.setTimeout(() => { copySiteLinkButton.textContent = 'Copy site link'; }, 1600);
    });

    const syncCountryLabels = () => {
      const hidden = map.getZoom() > 6;
      countryLabels.forEach((label) => label.getElement()?.classList.toggle('is-hidden', hidden));
    };

    const loadBoundaryContext = async () => {
      try {
        const response = await fetch('/assets/gis/potbellies/context-boundaries.geojson');
        if (!response.ok) throw new Error(`Boundary request returned ${response.status}`);
        const boundaries = await response.json() as Parameters<typeof L.geoJSON>[0];
        if (!document.contains(root) || activeGisMap !== map) return;

        map.createPane('gis-country-labels');
        const labelPane = map.getPane('gis-country-labels');
        if (labelPane) {
          labelPane.style.zIndex = '425';
          labelPane.style.pointerEvents = 'none';
        }

        L.geoJSON(boundaries, {
          interactive: false,
          style: {
            color: '#365c5f',
            weight: 1,
            opacity: 0.55,
            fillOpacity: 0,
          },
          onEachFeature(feature, layer) {
            const name = typeof feature.properties?.shapeName === 'string' ? feature.properties.shapeName : '';
            if (!name || !('getBounds' in layer)) return;
            const center = (layer as L.Polygon).getBounds().getCenter();
            const label = L.marker(center, {
              pane: 'gis-country-labels',
              interactive: false,
              keyboard: false,
              icon: L.divIcon({
                className: 'gis-country-label',
                html: `<span>${escapeHtml(name)}</span>`,
                iconSize: [0, 0],
              }),
            }).addTo(map);
            countryLabels.push(label);
          },
        }).addTo(map);

        syncCountryLabels();
        setMapStatus('Map ready');
      } catch {
        if (document.contains(root)) {
          setMapStatus('Geographic context unavailable — site records remain available.');
        }
      }
    };

    map.on('zoomend', syncCountryLabels);

    const syncFullscreenState = () => {
      const fullscreen = document.fullscreenElement === mapPanel;
      fullscreenButton.setAttribute('aria-label', fullscreen ? 'Exit fullscreen' : 'Enter fullscreen');
      if (fullscreenLabel) fullscreenLabel.textContent = fullscreen ? 'Exit fullscreen' : 'Fullscreen';
      fullscreenEnterIcon?.classList.toggle('is-hidden', fullscreen);
      fullscreenExitIcon?.classList.toggle('is-hidden', !fullscreen);
      window.requestAnimationFrame(() => map.invalidateSize({ pan: false }));
    };

    if (!mapPanel.requestFullscreen) {
      fullscreenButton.hidden = true;
    } else {
      fullscreenButton.addEventListener('click', async () => {
        try {
          if (document.fullscreenElement === mapPanel) await document.exitFullscreen();
          else await mapPanel.requestFullscreen();
        } catch {
          setMapStatus('Fullscreen could not open');
        }
      });
      mapPanel.addEventListener('fullscreenchange', syncFullscreenState);
      mapPanel.addEventListener('fullscreenerror', () => setMapStatus('Fullscreen could not open'));
    }

    const url = new URL(window.location.href);
    const requestedQuery = url.searchParams.get('q') || '';
    const requestedCountry = url.searchParams.get('country') || 'all';
    searchInput.value = requestedQuery;
    countrySelect.value = requestedCountry === 'all' || countryBySlug[requestedCountry] ? requestedCountry : 'all';
    applyFilters();
    fitVisibleSites();

    const requestedSiteId = decodeURIComponent(url.hash.slice(1));
    if (requestedSiteId && visibleSiteIds.has(requestedSiteId)) {
      selectSite(requestedSiteId, { updateUrl: false, moveMap: true, focusDetails: false });
    } else if (visibleSiteIds.has('S001')) {
      selectSite('S001', { updateUrl: false, moveMap: false, focusDetails: false });
    } else {
      clearSelection();
    }

    initializing = false;
    syncUrl();
    void loadBoundaryContext();
  }

  document.addEventListener('astro:page-load', () => { void initPotbellyGisDatabase(); });
  document.addEventListener('astro:before-swap', () => {
    activeGisMap?.remove();
    activeGisMap = null;
  });
</script>

