---
import Layout from '../../layouts/Layout.astro';
import ResearchHeader from '../../components/ResearchHeader.astro';
---

<Layout
  title="GIS Database — Preclassic Maya Potbelly Sculptures — Center for Mesoamerican Studies"
  description="Geographic distribution of recorded Preclassic Maya potbelly sculpture sites across Mesoamerica."
  bodyClass="potbelly-gis-page"
>
  <div class="gis-shell">
    <ResearchHeader currentHref="/grants-and-investigations" />

    <a class="gis-origin" href="/grants-and-investigations#potbelly-sculptures-project">
      <span aria-hidden="true">&larr;</span>
      Back to original project
    </a>

    <header class="gis-intro">
      <div class="gis-title-group">
        <p class="gis-project-id">09I03-03-V04-00234</p>
        <h2>GIS Database</h2>
      </div>
      <p class="gis-intro-copy">
        Geographic distribution of recorded potbelly sculpture sites across Mesoamerica. Marker size represents the number of monuments documented at each location.
      </p>
    </header>

    <section class="gis-map-section" aria-labelledby="gis-map-title">
      <header class="gis-map-heading">
        <div>
          <p>Interactive map</p>
          <h3 id="gis-map-title">Recorded sites across Mesoamerica</h3>
        </div>
        <a
          class="gis-full-map-link"
          href="/assets/gis/potbellies/index.html"
          target="_blank"
          rel="noopener"
          aria-label="Open the GIS map in a new tab"
        >
          Open full map <span aria-hidden="true">&nearr;</span>
        </a>
      </header>

      <div class="gis-map-frame">
        <iframe
          src="/assets/gis/potbellies/index.html"
          title="Interactive map of recorded potbelly sculpture sites"
          loading="eager"
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>

      <div class="gis-map-notes" aria-label="Map guidance">
        <p><strong>Map key</strong> Larger circles indicate more recorded monuments.</p>
        <p>Select a site marker to view its record.</p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .gis-shell {
    width: min(100%, 90rem);
    margin: 0 auto;
    padding: clamp(2rem, 4vw, 3.5rem) clamp(1.25rem, 4vw, 3rem) clamp(4rem, 8vw, 6rem);
  }

  .gis-origin {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    color: var(--site-teal);
    font-size: 0.92rem;
    text-underline-offset: 0.25em;
  }

  .gis-origin:hover,
  .gis-origin:focus-visible {
    color: var(--site-text-strong);
  }

  .gis-intro {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.5rem, 4vw, 3.5rem) 0 clamp(2.5rem, 6vw, 5rem);
  }

  .gis-title-group {
    display: grid;
    align-content: start;
    gap: 0.7rem;
  }

  .gis-project-id {
    margin: 0;
    color: var(--site-gold);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .gis-intro h2 {
    margin: 0;
    color: var(--site-text-strong);
    font-size: clamp(2.25rem, 6vw, 4.75rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .gis-intro-copy {
    max-width: 66ch;
    margin: 0;
    color: var(--site-text);
    font-size: 1rem;
    line-height: 1.75;
    text-wrap: pretty;
  }

  .gis-map-section {
    padding-top: clamp(2rem, 5vw, 4rem);
    border-top: 1px solid var(--site-border);
  }

  .gis-map-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 1.25rem;
  }

  .gis-map-heading p {
    margin: 0 0 0.35rem;
    color: var(--site-gold);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .gis-map-heading h3 {
    margin: 0;
    color: var(--site-text-strong);
    font-size: clamp(1.5rem, 3vw, 2.15rem);
    font-weight: 400;
    line-height: 1.2;
    text-wrap: balance;
  }

  .gis-full-map-link {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--site-border);
    border-radius: 3px;
    color: var(--site-teal);
    font-size: 0.84rem;
    text-decoration: none;
    transition: border-color 180ms var(--site-ease-out), color 180ms var(--site-ease-out);
  }

  .gis-full-map-link:hover,
  .gis-full-map-link:focus-visible {
    border-color: var(--site-gold);
    color: var(--site-gold);
  }

  .gis-map-frame {
    overflow: hidden;
    border: 1px solid var(--site-border);
    background: #e8e1d2;
  }

  .gis-map-frame iframe {
    display: block;
    width: 100%;
    height: clamp(34rem, 72svh, 52rem);
    border: 0;
    background: #e8e1d2;
  }

  .gis-map-notes {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--site-border);
  }

  .gis-map-notes p {
    margin: 0;
    color: var(--site-text-dim);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .gis-map-notes strong {
    margin-right: 0.35rem;
    color: var(--site-gold);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (min-width: 48rem) {
    .gis-intro {
      grid-template-columns: minmax(16rem, 0.8fr) minmax(0, 1.2fr);
      gap: clamp(2rem, 6vw, 6rem);
      align-items: end;
    }
  }

  @media (max-width: 36rem) {
    .gis-map-heading {
      display: grid;
      align-items: start;
    }

    .gis-full-map-link {
      justify-self: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gis-full-map-link {
      transition: none;
    }
  }
</style>
