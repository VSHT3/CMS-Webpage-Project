---
import Layout from '../layouts/Layout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeNotice from '../components/home/HomeNotice.astro';
import HomeScope from '../components/home/HomeScope.astro';
import HomePotbelly from '../components/home/HomePotbelly.astro';
import HomeRecent from '../components/home/HomeRecent.astro';
import HomeParu from '../components/home/HomeParu.astro';
import HomeWayfinding from '../components/home/HomeWayfinding.astro';
import HomeCloser from '../components/home/HomeCloser.astro';
import '../styles/home.css';

/*
  Current announcement. Set to null when there is nothing to announce — the band
  then renders no markup at all. This is the only hand-maintained value on the
  homepage; everything else derives from the repository.
*/
const notice: { label: string; text: string; href?: string } | null = null;
---
<Layout title="Home — Center for Mesoamerican Studies">
  <HomeHero />
  <HomeNotice notice={notice} />
  <HomeScope />
  <HomePotbelly />
  <HomeRecent />
  <HomeParu />
  <HomeWayfinding />
  <HomeCloser />
</Layout>

<script>
  async function fetchVisitorCount() {
    const el = document.getElementById('visit-count');
    if (!el) return;
    try {
      const res = await fetch('https://vsht.goatcounter.com/counter/TOTAL.json', { cache: 'no-store' });
      if (!res.ok) return;
      const data = await res.json();
      /*
        `count` is a preformatted string using U+202F as its thousands separator.
        Assign it, never parse it — parseInt() silently truncates past 999.
      */
      if (data?.count) el.textContent = data.count;
    } catch {}
  }

  function initModel() {
    const stage = document.querySelector('[data-model-stage]');
    const retry = document.querySelector('[data-load-model]') as HTMLButtonElement | null;
    if (!stage) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let requested = false;

    const createViewer = () => {
      const viewer = document.createElement('model-viewer');
      viewer.setAttribute('src', '/assets/models/statue-compressed.glb');
      viewer.setAttribute('poster', '/assets/optimized/model-poster.webp');
      viewer.setAttribute('camera-controls', '');
      viewer.setAttribute('disable-zoom', '');
      viewer.setAttribute('interaction-prompt', 'none');
      viewer.setAttribute('camera-orbit', '90deg 72deg 105%');
      viewer.setAttribute('min-camera-orbit', 'auto auto 60%');
      viewer.setAttribute('max-camera-orbit', 'auto auto 200%');
      viewer.setAttribute('field-of-view', '45deg');
      viewer.setAttribute('min-field-of-view', '20deg');
      viewer.setAttribute('max-field-of-view', '75deg');
      viewer.setAttribute('alt', '3D model of a Mesoamerican artefact');
      if (!reducedMotion.matches) {
        viewer.setAttribute('auto-rotate', '');
        viewer.setAttribute('auto-rotate-delay', '0');
        viewer.setAttribute('rotation-per-second', '18deg');
      }
      stage.replaceChildren(viewer);
      retry?.setAttribute('hidden', '');
    };

    /* The button only ever appears once this has failed. */
    const failed = () => {
      requested = false;
      retry?.removeAttribute('hidden');
      if (retry) retry.textContent = 'Load interactive view';
    };

    const appendViewer = () => {
      if (requested) return;
      requested = true;
      if (retry) retry.textContent = 'Loading';

      if (customElements.get('model-viewer')) {
        createViewer();
        return;
      }

      const script = document.createElement('script');
      script.type = 'module';
      script.src = '/assets/vendor/model-viewer.min.js';
      script.addEventListener('load', createViewer);
      script.addEventListener('error', failed);
      document.head.append(script);
    };

    retry?.addEventListener('click', appendViewer);

    const schedule = () => {
      if (requested) return;
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            if (entries.some((entry) => entry.isIntersecting)) {
              observer.disconnect();
              appendViewer();
            }
          },
          { rootMargin: '360px 0px' },
        );
        observer.observe(stage);
        return;
      }
      globalThis.setTimeout(appendViewer, 800);
    };

    const idleWindow = window as Window & {
      requestIdleCallback?: (callback: () => void, options?: { timeout?: number }) => number;
    };
    if (idleWindow.requestIdleCallback) {
      idleWindow.requestIdleCallback(schedule, { timeout: 1400 });
    } else {
      globalThis.setTimeout(schedule, 450);
    }
  }

  function initReveal() {
    const targets = document.querySelectorAll<HTMLElement>('.h-reveal');
    if (targets.length === 0) return;

    if (
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
      !('IntersectionObserver' in window)
    ) {
      targets.forEach((target) => target.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
    );

    targets.forEach((target) => observer.observe(target));
  }

  function init() {
    fetchVisitorCount();
    initModel();
    initReveal();
  }

  document.addEventListener('astro:page-load', init);
</script>
