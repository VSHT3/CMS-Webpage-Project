---
import Layout from '../layouts/Layout.astro';
import ResearchHeader from '../components/ResearchHeader.astro';
---

<Layout
  title="Gallery — Research — Center for Mesoamerican Studies"
  description="Photo gallery from research projects of the Center for Mesoamerican Studies."
  bodyClass="research-gallery-page"
>
  <div class="rg-shell">
    <ResearchHeader currentHref="/grants-and-investigations-gallery" />
    <p class="rg-placeholder">Content coming soon.</p>
  </div>
</Layout>

<style>
  .rg-shell {
    width: min(100%, 90rem);
    margin: 0 auto;
    padding: clamp(2rem, 4vw, 3.5rem) clamp(1.25rem, 4vw, 3rem) clamp(4rem, 8vw, 6rem);
  }

  .rg-placeholder {
    margin: 0;
    font-family: var(--site-font);
    font-size: 1rem;
    color: var(--site-text-dim);
    font-style: italic;
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }
</style>
