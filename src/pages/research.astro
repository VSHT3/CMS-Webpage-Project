---
import Layout from '../layouts/Layout.astro';
import ResearchHeader from '../components/ResearchHeader.astro';
import { REPORT_PAGE_PATH } from '../data/archaeological-reports';

const researchLinks = [
  {
    title: 'PARU Uaxactun Reports',
    href: REPORT_PAGE_PATH,
    description: 'Uaxactun and Petén Noreste archaeological report series, with direct access to published PDFs.',
  },
  {
    title: 'Grants',
    href: '/grants-and-investigations-grants',
    description: 'Active grants and grant-supported research at the Center.',
  },
  {
    title: 'Project Reports',
    href: '/grants-and-investigations',
    description: 'Funded research projects, reports, and related databases.',
  },
  {
    title: 'Investigation Notes',
    href: '/grants-and-investigations-investigation-notes',
    description: 'Notes from the Center’s ongoing research and investigations.',
  },
  {
    title: 'Gallery',
    href: '/grants-and-investigations-gallery',
    description: 'Images from the Center’s research work and field investigations.',
  },
];
---

<Layout
  title="Research — Center for Mesoamerican Studies"
  description="Research at the Center for Mesoamerican Studies, including PARU Uaxactun archaeological reports, grants, projects, investigation notes, and galleries."
  bodyClass="research-page"
>
  <div class="research-shell">
    <ResearchHeader currentHref="/research" />

    <section class="research-intro reveal-target" style="--reveal-delay: 80ms" aria-labelledby="research-intro-title">
      <h2 class="research-intro-title" id="research-intro-title">Research at the Center</h2>
      <p class="research-intro-text">
        The Center’s research pages bring together PARU Uaxactun archaeological reports, grant-supported work, project documentation, investigation notes, and galleries.
      </p>
    </section>

    <nav class="research-overview reveal-target" style="--reveal-delay: 140ms" aria-labelledby="research-sections-title">
      <h2 class="research-section-label" id="research-sections-title">Explore research</h2>
      <ul class="research-link-list">
        {researchLinks.map((item) => (
          <li class="research-link-item">
            <a class="research-link" href={item.href} aria-label={`${item.title}: ${item.description}`}>
              <span class="research-link-title">{item.title}</span>
              <span class="research-link-description">{item.description}</span>
              <span class="research-link-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</Layout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll<HTMLElement>('.reveal-target');

  if (!reduceMotion && targets.length > 0 && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const element = entry.target as HTMLElement;
            element.style.transitionDelay = element.style.getPropertyValue('--reveal-delay') || '0ms';
            element.classList.add('is-visible');
            observer.unobserve(element);
          }
        });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
    );

    targets.forEach((element) => {
      element.classList.add('will-reveal');
      observer.observe(element);
    });
  }
</script>

<style>
  .research-shell {
    width: min(100%, 90rem);
    margin: 0 auto;
    padding: clamp(2rem, 4vw, 3.5rem) clamp(1.25rem, 4vw, 3rem) clamp(4rem, 8vw, 6rem);
  }

  .research-intro {
    display: grid;
    gap: 1rem;
    padding: clamp(2rem, 4vw, 3rem) 0;
    border-bottom: 1px solid var(--site-border);
  }

  .research-intro-title {
    margin: 0;
    font-family: var(--site-font-display);
    font-size: clamp(1.4rem, 3.2vw, 2.2rem);
    font-weight: 400;
    letter-spacing: 0.03em;
    color: var(--site-text-strong);
  }

  .research-intro-text {
    max-width: 65ch;
    margin: 0;
    font-size: clamp(1rem, 1.35vw, 1.1rem);
    line-height: 1.8;
    color: var(--site-text);
    text-wrap: pretty;
  }

  .research-overview {
    padding: clamp(2.5rem, 5vw, 4rem) 0 0;
  }

  .research-section-label {
    margin: 0 0 clamp(1.5rem, 3vw, 2.5rem);
    font-family: var(--site-font-ui);
    font-size: clamp(0.78rem, 1.1vw, 0.88rem);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--site-text-dim);
  }

  .research-link-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--site-border);
  }

  .research-link-item {
    border-top: 1px solid var(--site-border);
  }

  .research-link {
    display: grid;
    grid-template-columns: minmax(12rem, 0.65fr) minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    min-height: 4.75rem;
    padding: 1.25rem 0.5rem;
    color: var(--site-text);
    text-decoration: none;
    transition: color 220ms var(--site-ease-out), transform 320ms var(--site-ease-out);
  }

  .research-link-title {
    font-family: var(--site-font-display);
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    font-weight: 500;
    line-height: 1.35;
    color: var(--site-text-strong);
    text-wrap: balance;
    transition: color 220ms var(--site-ease-out);
  }

  .research-link-description {
    max-width: 58ch;
    font-size: clamp(0.9rem, 1.1vw, 1rem);
    line-height: 1.65;
    color: var(--site-text-dim);
    text-wrap: pretty;
  }

  .research-link-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    min-height: 2.75rem;
    font-family: var(--site-font-ui);
    font-size: 1.15rem;
    color: var(--site-gold);
    transition: transform 320ms var(--site-ease-out);
  }

  .research-link:hover,
  .research-link:focus-visible {
    transform: translateX(0.25rem);
  }

  .research-link:hover .research-link-title,
  .research-link:focus-visible .research-link-title {
    color: var(--site-gold);
  }

  .research-link:hover .research-link-arrow,
  .research-link:focus-visible .research-link-arrow {
    transform: translateX(0.25rem);
  }

  .research-link:focus-visible {
    outline: 2px solid color-mix(in oklab, var(--site-gold) 76%, var(--site-text-strong));
    outline-offset: 3px;
  }

  .will-reveal {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 500ms var(--site-ease-out), transform 600ms var(--site-ease-out);
    will-change: opacity, transform;
  }

  .will-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 760px) {
    .research-link {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.5rem 1rem;
    }

    .research-link-description {
      grid-column: 1;
    }

    .research-link-arrow {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .research-link,
    .research-link-title,
    .research-link-arrow,
    .will-reveal {
      transition: none;
    }

    .research-link:hover,
    .research-link:focus-visible,
    .research-link:hover .research-link-arrow,
    .research-link:focus-visible .research-link-arrow {
      transform: none;
    }

    .will-reveal {
      opacity: 1;
      transform: none;
    }
  }
</style>
