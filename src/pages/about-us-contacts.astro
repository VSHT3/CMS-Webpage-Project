---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contacts — Center for Mesoamerican Studies"
  description="Contact information for the Center for Mesoamerican Studies at Comenius University Bratislava — address, phone, and map."
  bodyClass="contacts-page"
>
  <div class="contacts-shell">

    <header class="contacts-header reveal-target">
      <div class="contacts-header-row">
        <h1 class="contacts-page-title">About Us</h1>
        <div class="contacts-institution" aria-label="Institutional affiliation">
          <span>Faculty of Arts</span>
          <span>Comenius University Bratislava</span>
        </div>
      </div>
      <hr class="contacts-rule" />
      <nav class="contacts-subnav" aria-label="About Us pages">
        <a href="/about-us" class="contacts-subnav-link">Overview</a>
        <span class="contacts-subnav-sep" aria-hidden="true"></span>
        <a href="/abouts-us-members" class="contacts-subnav-link">Members</a>
        <span class="contacts-subnav-sep" aria-hidden="true"></span>
        <a href="/about-us-contacts" class="contacts-subnav-link is-current" aria-current="page">Contacts</a>
      </nav>
    </header>

    <div class="contacts-intro reveal-target" style="--reveal-delay: 80ms">
      <h2 class="contacts-section-title">Contacts</h2>
    </div>

    <article class="contacts-content">

      <section class="contacts-block reveal-target" style="--reveal-delay: 120ms">
        <h3 class="contacts-label">Address</h3>
        <address class="contacts-address">
          Štúrova 9<br />
          811 02 Bratislava<br />
          Slovakia
        </address>
      </section>

      <section class="contacts-block reveal-target" style="--reveal-delay: 175ms">
        <h3 class="contacts-label">Phone</h3>
        <ul class="contacts-phones">
          <li><a href="tel:+421911623174">T: (+421) 911 623 174</a></li>
          <li><a href="tel:+420723928022">T: (+420) 723 928 022</a></li>
        </ul>
      </section>

      <section class="contacts-block reveal-target" style="--reveal-delay: 230ms">
        <h3 class="contacts-label">Email</h3>
        <a href="mailto:jakub.spotak@uniba.sk" class="contacts-email">jakub.spotak@uniba.sk</a>
      </section>

      <div class="contacts-map reveal-target" style="--reveal-delay: 285ms" aria-label="Location map">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d5324.721393266933!2d17.110756!3d48.141851!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x476c89417ff82023%3A0xa847e9437ca633a4!2zxaB0w7pyb3ZhIDIyLzksIDgxMSAwMiBTdGFyw6kgTWVzdG8sIFNsb3Zha2lh!5e0!3m2!1sen!2sus!4v1763308996382!5m2!1sen!2sus"
          width="100%"
          height="420"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="CMS location — Štúrova 9, Bratislava"
        ></iframe>
      </div>

    </article>
  </div>
</Layout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll<HTMLElement>('.reveal-target');

  if (!reduceMotion && targets.length > 0 && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            (entry.target as HTMLElement).style.transitionDelay =
              (entry.target as HTMLElement).style.getPropertyValue('--reveal-delay') || '0ms';
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
    );
    targets.forEach((el) => {
      el.classList.add('will-reveal');
      observer.observe(el);
    });
  }
</script>

<style>
  .contacts-shell {
    width: min(100%, 90rem);
    margin: 0 auto;
    padding: clamp(2rem, 4vw, 3.5rem) clamp(1.25rem, 4vw, 3rem) clamp(4rem, 8vw, 6rem);
  }

  /* ── Header ── */
  .contacts-header {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .contacts-header-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  .contacts-page-title {
    margin: 0;
    font-family: var(--site-font);
    font-size: clamp(3.2rem, 7.5vw, 7rem);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: 0.04em;
    color: var(--site-text);
    text-wrap: balance;
    flex-shrink: 0;
  }

  .contacts-institution {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.2rem;
    padding-bottom: 0.3rem;
  }

  .contacts-institution span {
    font-family: var(--site-font);
    font-size: clamp(0.72rem, 1.1vw, 0.82rem);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--site-text-dim);
    text-align: right;
    line-height: 1.4;
  }

  .contacts-rule {
    border: 0;
    border-top: 1px solid oklch(0.76 0.08 92 / 0.5);
    margin: 0 0 1.4rem;
  }

  .contacts-subnav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .contacts-subnav-link {
    font-family: var(--site-font);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--site-text-dim);
    text-decoration: none;
    transition: color 180ms var(--site-ease-out);
  }

  .contacts-subnav-link:hover,
  .contacts-subnav-link:focus-visible {
    color: var(--site-gold);
  }

  .contacts-subnav-link.is-current {
    color: var(--site-gold);
  }

  .contacts-subnav-sep {
    display: inline-block;
    width: 1px;
    height: 0.7em;
    background: var(--site-border);
    opacity: 0.7;
  }

  /* ── Intro ── */
  .contacts-intro {
    padding: clamp(2rem, 4vw, 3rem) 0;
    border-bottom: 1px solid var(--site-border);
  }

  .contacts-section-title {
    margin: 0;
    font-family: var(--site-font);
    font-size: clamp(1.4rem, 3.2vw, 2.2rem);
    font-weight: 400;
    letter-spacing: 0.03em;
    color: var(--site-text-strong);
    text-wrap: balance;
  }

  /* ── Blocks ── */
  .contacts-content {
    display: grid;
    gap: 0;
  }

  .contacts-block {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.6rem 0;
    padding: clamp(1.75rem, 3.5vw, 2.75rem) 0;
    border-bottom: 1px solid var(--site-border);
  }

  @media (min-width: 680px) {
    .contacts-block {
      grid-template-columns: 13rem 1fr;
      gap: 0 clamp(2rem, 3.5vw, 3rem);
      align-items: start;
    }
  }

  @media (min-width: 1100px) {
    .contacts-block {
      grid-template-columns: 5.5rem 14rem 1fr;
      gap: 0 clamp(1.5rem, 2.5vw, 2.5rem);
    }

    .contacts-block::before {
      content: '';
      display: block;
    }
  }

  @media (min-width: 1400px) {
    .contacts-block {
      grid-template-columns: 5.5rem 16rem 1fr;
    }
  }

  .contacts-label {
    margin: 0;
    font-family: var(--site-font);
    font-size: clamp(0.78rem, 1.1vw, 0.88rem);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--site-text-dim);
    padding-top: 0.35rem;
  }

  .contacts-address {
    font-style: normal;
    color: var(--site-text-strong);
    font-size: 1.0625rem;
    line-height: 1.88;
    margin: 0;
    -webkit-font-smoothing: auto;
  }

  .contacts-phones {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  .contacts-phones a {
    color: var(--site-text-strong);
    font-size: 1.0625rem;
    text-decoration: none;
    transition: color 180ms var(--site-ease-out);
    -webkit-font-smoothing: auto;
  }

  .contacts-phones a:hover,
  .contacts-phones a:focus-visible {
    color: var(--site-gold);
  }

  .contacts-email {
    color: var(--site-teal);
    font-size: 1.0625rem;
    text-decoration: none;
    transition: color 180ms var(--site-ease-out);
    -webkit-font-smoothing: auto;
  }

  .contacts-email:hover,
  .contacts-email:focus-visible {
    color: var(--site-gold);
  }

  .contacts-map {
    margin-top: clamp(2rem, 4vw, 3rem);
    overflow: hidden;
    border-radius: 3px;
    border: 1px solid var(--site-border);
  }

  .contacts-map iframe {
    display: block;
    width: 100%;
  }

  /* ── Scroll reveal ── */
  .will-reveal {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 500ms var(--site-ease-out),
      transform 600ms var(--site-ease-out);
    will-change: opacity, transform;
  }

  .will-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .will-reveal {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }

  /* ── Mobile ── */
  @media (max-width: 679px) {
    .contacts-header-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .contacts-institution {
      align-items: flex-start;
    }

    .contacts-institution span {
      text-align: left;
    }

    .contacts-label {
      color: var(--site-gold);
      font-size: 0.72rem;
    }
  }
</style>
