---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">

    <div class="footer-brand">
      <img
        src="/assets/LogoTest_ULR2LENFW1uu6krJGVj2C.png"
        alt="CMS Logo"
        width="88"
        height="88"
      />
      <div class="footer-brand-text">
        <span class="footer-wordmark">mesoamerica.eu</span>
        <span class="footer-tagline">Center for Mesoamerican Studies</span>
      </div>
    </div>

    <nav class="footer-nav" aria-label="Footer site navigation">
      <a href="/">Home</a>
      <a href="/about-us">About</a>
      <a href="/research">Research</a>
      <a href="/events">Conferences</a>
      <a href="/publications">Publications</a>
      <a href="/gallery">Collections</a>
      <a href="/ferdinand-anders-library-history">Library</a>
    </nav>

    <address class="footer-contact">
      <span>Štúrova 9, 811 02 Bratislava</span>
      <a href="tel:+421911623174">(+421) 911 623 174</a>
      <a href="mailto:jakub.spotak@uniba.sk">jakub.spotak@uniba.sk</a>
      <a href="https://fphil.uniba.sk/" target="_blank" rel="noopener">Faculty of Arts ↗</a>
    </address>

  </div>

  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <span>© {year} Center for Mesoamerican Studies · Faculty of Arts, Comenius University Bratislava</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: color-mix(in oklab, var(--site-bg-deep) 88%, oklch(0.1 0.018 205));
    border-top: 1px solid var(--site-border);
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .footer-inner {
    width: 100%;
    padding: clamp(2rem, 3.5vw, 3rem) clamp(1.25rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  /* ── Brand ── */
  .footer-brand {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .footer-brand img {
    width: 88px;
    height: 88px;
    object-fit: contain;
    opacity: 0.9;
    flex-shrink: 0;
  }

  .footer-brand-text {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .footer-wordmark {
    font-family: var(--site-font);
    font-size: 1.55rem;
    letter-spacing: 0.06em;
    color: var(--site-text-strong);
    line-height: 1;
  }

  .footer-tagline {
    font-family: var(--site-font);
    font-size: 0.88rem;
    color: var(--site-text-dim);
    letter-spacing: 0.03em;
    line-height: 1.4;
  }

  /* ── Nav ── */
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 2rem;
    justify-content: center;
  }

  .footer-nav a {
    font-family: var(--site-font);
    font-size: 0.88rem;
    letter-spacing: 0.06em;
    color: var(--site-text-dim);
    text-decoration: none;
    transition: color 180ms var(--site-ease-out);
    white-space: nowrap;
  }

  .footer-nav a:hover,
  .footer-nav a:focus-visible {
    color: var(--site-text);
  }

  /* ── Contact ── */
  .footer-contact {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    align-items: flex-end;
    text-align: right;
  }

  .footer-contact span,
  .footer-contact a {
    font-size: 0.85rem;
    color: var(--site-text-dim);
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color 180ms var(--site-ease-out);
    line-height: 1.5;
  }

  .footer-contact a:hover,
  .footer-contact a:focus-visible {
    color: var(--site-gold);
  }

  /* ── Bottom bar ── */
  .footer-bottom-inner {
    padding: 0.85rem clamp(1.25rem, 4vw, 3rem);
  }

  .footer-bottom span {
    font-size: 0.73rem;
    color: var(--site-text-dim);
    letter-spacing: 0.03em;
    opacity: 0.65;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-nav {
      justify-content: flex-start;
    }

    .footer-contact {
      align-items: flex-start;
      text-align: left;
    }
  }

  @media (max-width: 520px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }

    .footer-brand {
      grid-column: auto;
    }

    .footer-brand img {
      width: 64px;
      height: 64px;
    }
  }
</style>
