---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">

    <div class="footer-brand">
      <div class="footer-brand-logo">
        <img
          src="/assets/LogoTest_ULR2LENFW1uu6krJGVj2C.png"
          alt="CMS Logo"
          width="52"
          height="52"
        />
      </div>
      <div class="footer-brand-text">
        <span class="footer-wordmark">mesoamerica.eu</span>
        <p class="footer-tagline">Center for Mesoamerican Studies</p>
        <p class="footer-affiliation">Faculty of Arts · Comenius University Bratislava · est. 2015</p>
      </div>
    </div>

    <nav class="footer-nav" aria-label="Footer site navigation">
      <p class="footer-nav-heading">Site</p>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/about-us">About Us</a></li>
        <li><a href="/research">Research</a></li>
        <li><a href="/events">Conferences</a></li>
        <li><a href="/publications">Publications</a></li>
        <li><a href="/gallery">Collections</a></li>
        <li><a href="/ferdinand-anders-library-history">Library</a></li>
      </ul>
    </nav>

    <div class="footer-contact">
      <p class="footer-nav-heading">Contact</p>
      <address>
        <p>Štúrova 9<br />811 02 Bratislava<br />Slovakia</p>
        <p>
          <a href="tel:+421911623174">(+421) 911 623 174</a>
        </p>
        <p>
          <a href="mailto:jakub.spotak@uniba.sk">jakub.spotak@uniba.sk</a>
        </p>
      </address>
      <a
        href="https://fphil.uniba.sk/"
        target="_blank"
        rel="noopener"
        class="footer-external"
      >Faculty of Arts ↗</a>
    </div>

  </div>

  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <span>© {year} Center for Mesoamerican Studies, Faculty of Arts, Comenius University Bratislava</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: color-mix(in oklab, var(--site-bg-deep) 88%, oklch(0.1 0.018 205));
    border-top: 1px solid var(--site-border);
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .footer-inner {
    max-width: 90rem;
    margin: 0 auto;
    padding: clamp(3rem, 5vw, 4.5rem) clamp(1.25rem, 4vw, 3rem) clamp(2.5rem, 4vw, 3.5rem);
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }

  /* ── Brand ── */
  .footer-brand {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .footer-brand-logo img {
    width: 48px;
    height: 48px;
    object-fit: contain;
    opacity: 0.88;
    margin-top: 0.1rem;
  }

  .footer-brand-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .footer-wordmark {
    font-family: var(--site-font);
    font-size: 1.1rem;
    letter-spacing: 0.08em;
    color: var(--site-text-strong);
    display: block;
  }

  .footer-tagline {
    margin: 0;
    color: var(--site-text);
    font-size: 0.9rem;
    line-height: 1.5;
    max-width: none;
  }

  .footer-affiliation {
    margin: 0.3rem 0 0;
    color: var(--site-text-dim);
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    line-height: 1.6;
    max-width: none;
  }

  /* ── Nav + Contact shared heading ── */
  .footer-nav-heading {
    margin: 0 0 0.9rem;
    font-family: var(--site-font);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--site-gold);
    max-width: none;
  }

  /* ── Nav ── */
  .footer-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer-nav a {
    font-size: 0.88rem;
    color: var(--site-text-dim);
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color 180ms var(--site-ease-out);
  }

  .footer-nav a:hover,
  .footer-nav a:focus-visible {
    color: var(--site-text);
  }

  /* ── Contact ── */
  .footer-contact address {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-contact address p {
    margin: 0;
    color: var(--site-text-dim);
    font-size: 0.88rem;
    line-height: 1.65;
    max-width: none;
  }

  .footer-contact address a {
    color: var(--site-text-dim);
    text-decoration: none;
    font-size: 0.88rem;
    transition: color 180ms var(--site-ease-out);
  }

  .footer-contact address a:hover,
  .footer-contact address a:focus-visible {
    color: var(--site-gold);
  }

  .footer-external {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-family: var(--site-font);
    color: var(--site-text-dim);
    text-decoration: none;
    transition: color 180ms var(--site-ease-out);
  }

  .footer-external:hover,
  .footer-external:focus-visible {
    color: var(--site-gold);
  }

  /* ── Bottom bar ── */
  .footer-bottom {
    border-top: 1px solid var(--site-border);
  }

  .footer-bottom-inner {
    max-width: 90rem;
    margin: 0 auto;
    padding: 1rem clamp(1.25rem, 4vw, 3rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .footer-bottom span {
    font-size: 0.75rem;
    color: var(--site-text-dim);
    letter-spacing: 0.03em;
    opacity: 0.7;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-brand {
      grid-column: auto;
    }
  }
</style>
