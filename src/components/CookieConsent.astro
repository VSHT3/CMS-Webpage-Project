---
---
<div id="cookie-banner" role="dialog" aria-label="Cookie consent" aria-live="polite" hidden>
  <p>
    We use cookies to see how people find our site, so we can keep improving it.
  </p>
  <div class="cookie-actions">
    <button id="cookie-accept" type="button">Accept</button>
    <button id="cookie-reject" type="button">Reject</button>
  </div>
</div>

<script>
  const STORAGE_KEY = 'cms_cookie_consent';

  function updateConsent(granted: boolean) {
    // @ts-ignore
    if (typeof gtag === 'function') {
      // @ts-ignore
      gtag('consent', 'update', {
        analytics_storage: granted ? 'granted' : 'denied',
        ad_storage: 'denied',
      });
    }
    localStorage.setItem(STORAGE_KEY, granted ? 'granted' : 'denied');
  }

  function init() {
    const banner = document.getElementById('cookie-banner');
    const acceptBtn = document.getElementById('cookie-accept');
    const rejectBtn = document.getElementById('cookie-reject');
    if (!banner || !acceptBtn || !rejectBtn) return;

    const stored = localStorage.getItem(STORAGE_KEY);

    if (stored === 'granted') {
      updateConsent(true);
      return;
    }
    if (stored === 'denied') {
      return;
    }

    // No decision yet — show banner
    banner.hidden = false;
    // Animate in after paint
    requestAnimationFrame(() => banner.classList.add('visible'));

    acceptBtn.addEventListener('click', () => {
      updateConsent(true);
      banner.classList.remove('visible');
      setTimeout(() => { banner.hidden = true; }, 300);
    }, { once: true });

    rejectBtn.addEventListener('click', () => {
      updateConsent(false);
      banner.classList.remove('visible');
      setTimeout(() => { banner.hidden = true; }, 300);
    }, { once: true });
  }

  document.addEventListener('astro:page-load', init);
</script>

<style>
  #cookie-banner {
    position: fixed;
    bottom: 1.5rem;
    left: 1.5rem;
    z-index: 200;
    width: min(470px, calc(100vw - 3rem));
    background: var(--site-bg-deep);
    border: 1px solid var(--site-border);
    border-radius: 4px;
    padding: 0.9rem 1.1rem;
    box-shadow: var(--site-shadow);
    font-family: var(--site-font);
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1rem;
    opacity: 0;
    translate: 0 0.75rem;
    transition:
      opacity 280ms var(--site-ease-out),
      translate 280ms var(--site-ease-out);
  }

  #cookie-banner[hidden] {
    display: none;
  }

  #cookie-banner.visible {
    opacity: 1;
    translate: 0 0;
  }

  #cookie-banner p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--site-text-dim);
    line-height: 1.5;
    max-width: none;
    flex: 1;
  }

  .cookie-actions {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .cookie-actions button {
    font-family: var(--site-font);
    font-size: 0.875rem;
    padding: 0.4rem 1.1rem;
    border-radius: 3px;
    border: 1px solid var(--site-border);
    cursor: pointer;
    transition: background 180ms, color 180ms, border-color 180ms;
  }

  #cookie-accept {
    background: var(--site-gold);
    color: oklch(0.15 0.022 202);
    border-color: var(--site-gold);
  }

  #cookie-accept:hover {
    background: oklch(0.82 0.09 92);
    border-color: oklch(0.82 0.09 92);
  }

  #cookie-reject {
    background: transparent;
    color: var(--site-text-dim);
  }

  #cookie-reject:hover {
    border-color: var(--site-text-dim);
    color: var(--site-text);
  }
</style>
