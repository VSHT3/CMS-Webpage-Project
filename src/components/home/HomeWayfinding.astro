---
const sections = [
  {
    href: '/grants-and-investigations',
    title: 'Research & grants',
    text: 'Projects, grants, investigation notes, and field reports.',
  },
  {
    href: '/publications',
    title: 'Publications',
    text: 'Books, reports, catalogues, and downloadable PDF records.',
  },
  {
    href: '/collection-archaeological-collection',
    title: 'Collections',
    text: 'Archaeological and ethnographical holdings, exhibitions, and galleries.',
  },
  {
    href: '/ferdinand-anders-library',
    title: 'Ferdinand Anders Library',
    text: 'Library history and catalogue access for researchers and visitors.',
  },
  {
    href: '/education-phd-program',
    title: 'PhD program',
    text: 'Doctoral study, published theses, and work in progress.',
  },
  {
    href: '/bratislava-maya-meetings-history',
    title: 'Bratislava Maya Meetings',
    text: 'Conference history, news, and gallery from the annual meetings.',
  },
];
---
<section class="wayfinding h-band h-band--deep h-band--ruled">
  <div class="h-track">
    <div class="wayfinding-head">
      <p class="h-eyebrow h-reveal" style="--h-i:0">Sections</p>
      <h2 class="h-title h-reveal" style="--h-i:1">Find the part of the center you need.</h2>
    </div>

    <div class="wayfinding-grid">
      {sections.map((section, i) => (
        <a class="wayfinding-card h-reveal" style={`--h-i:${i}`} href={section.href}>
          <span class="h-meta">{String(i + 1).padStart(2, '0')}</span>
          <h3>{section.title}</h3>
          <p>{section.text}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .wayfinding-head {
    margin-bottom: clamp(1.75rem, 3vw, 3rem);
  }

  .wayfinding-head .h-title {
    max-width: 20ch;
  }

  .wayfinding-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.4vw, 2rem);
  }

  .wayfinding-card {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--site-border);
    transition: transform 380ms var(--site-ease-out);
  }

  .wayfinding-card h3 {
    margin: 0;
    font-family: var(--site-font-display);
    font-weight: 400;
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    line-height: 1.18;
    color: var(--site-text-strong);
    transition: color 220ms var(--site-ease-out);
  }

  .wayfinding-card p {
    margin: 0;
    max-width: 40ch;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--site-text-dim);
  }

  .wayfinding-card:hover,
  .wayfinding-card:focus-visible {
    transform: translateY(-0.25rem);
  }

  .wayfinding-card:hover h3,
  .wayfinding-card:focus-visible h3 {
    color: var(--site-gold);
  }

  .wayfinding-card:focus-visible {
    outline: 2px solid color-mix(in oklab, var(--site-gold) 76%, var(--site-text-strong));
    outline-offset: 4px;
  }

  @media (max-width: 1080px) {
    .wayfinding-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .wayfinding-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wayfinding-card,
    .wayfinding-card h3 {
      transition: none;
    }

    .wayfinding-card:hover,
    .wayfinding-card:focus-visible {
      transform: none;
    }
  }
</style>
