<style>
  @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&display=swap');

  :root {
    --nav-bg: #31555a;
    --nav-bg-dark: #274449;
    --nav-text: #f4ecde;
    --nav-text-dim: #d8ccb6;
    --nav-gold: #e0bb70;
    --nav-gold-light: #f0cf8c;
    --nav-border: #52747a;
    --nav-logo-h: 108px;
    --nav-font: 'Cinzel', 'Palatino Linotype', Georgia, serif;
  }

  .site-nav-wrapper {
    position: sticky;
    top: 0;
    z-index: 9999;
    background: linear-gradient(180deg, #3d666c 0%, var(--nav-bg) 100%);
    border-bottom: 1px solid var(--nav-border);
    box-shadow: 0 10px 28px rgba(7, 24, 27, 0.24);
    color: var(--nav-text);
  }

  .site-nav {
    display: flex;
    align-items: stretch;
    height: var(--nav-logo-h);
    padding: 0;
    margin: 0;
    overflow: visible;
  }

  /* ── Logo ───────────────────────────── */
  .nav-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none !important;
    line-height: 0;
    padding-right: 0.75rem;
  }

  .nav-logo-img {
    display: block;
    height: var(--nav-logo-h);
    width: auto;
    object-fit: contain;
  }

  /* ── Nav links row ──────────────────── */
  .nav-links {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    list-style: none;
    margin: 0;
    padding: 0 1rem;
    flex: 1;
    min-width: 0;
    overflow: visible;
    scrollbar-width: none;
  }

  .nav-links::-webkit-scrollbar {
    display: none;
  }

  /* ── Individual item ────────────────── */
  .nav-item {
    position: relative;
    display: flex;
    align-items: stretch;
    flex: 1 1 auto;
    justify-content: center;
  }

  .nav-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 100%;
    padding: 0 clamp(0.95rem, 1.4vw, 1.5rem);
    font-family: var(--nav-font);
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: 0.045em;
    line-height: 1.15;
    text-transform: uppercase;
    color: var(--nav-text) !important;
    text-decoration: none !important;
    white-space: nowrap;
    transition: color 0.2s ease;
    border-bottom: 2px solid transparent;
    cursor: pointer;
  }

  .nav-link:hover,
  .nav-item:focus-within > .nav-link {
    color: var(--nav-gold) !important;
    border-bottom-color: var(--nav-gold);
  }

  .chevron {
    flex-shrink: 0;
    opacity: 0.65;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .nav-item:hover .chevron,
  .nav-item:focus-within .chevron {
    transform: rotate(180deg);
    opacity: 1;
  }

  /* ── Dropdown panel ─────────────────── */
  .dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    min-width: max-content;
    width: max-content;
    max-width: min(24rem, calc(100vw - 2rem));
    background: var(--nav-bg-dark);
    border: 1px solid var(--nav-border);
    border-top: 2px solid var(--nav-gold);
    box-shadow: 0 16px 32px rgba(7, 24, 27, 0.24);
    list-style: none;
    margin: 0;
    padding: 6px 0;
    z-index: 10000;
  }

  .has-dropdown:hover > .dropdown,
  .has-dropdown:focus-within > .dropdown {
    display: block;
  }

  .dropdown li {
    margin: 0;
    padding: 0;
  }

  .dropdown a {
    display: block;
    padding: 11px 18px;
    font-family: var(--nav-font);
    font-size: 12.5px;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--nav-text-dim) !important;
    text-decoration: none !important;
    transition: color 0.15s ease, background 0.15s ease, padding-inline 0.15s ease;
  }

  .dropdown a:hover {
    color: var(--nav-gold-light) !important;
    background: rgba(240, 207, 140, 0.12);
    padding-inline: 22px 14px;
  }

  /* ── Mobile hamburger (simple) ──────── */
  .nav-mobile-toggle {
    display: none;
  }

  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }

    .site-nav {
      justify-content: space-between;
    }

    .nav-mobile-toggle {
      display: flex;
      align-items: center;
      padding: 0 20px;
      background: none;
      border: none;
      color: var(--nav-text);
      cursor: pointer;
      font-size: 22px;
    }

    .nav-links.open {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      position: fixed;
      top: var(--nav-logo-h);
      left: 0;
      right: 0;
      bottom: 0;
      background: var(--nav-bg-dark);
      overflow-y: auto;
      overflow-x: hidden;
      padding: 12px 0;
      z-index: 9998;
    }

    .nav-links.open .nav-item {
      width: 100%;
      flex: 0 0 auto;
      flex-direction: column;
      align-items: flex-start;
    }

    .nav-links.open .nav-link {
      width: 100%;
      padding: 14px 24px;
      font-size: 14px;
      border-bottom: 1px solid var(--nav-border);
      justify-content: flex-start;
    }

    .nav-links.open .dropdown {
      display: block;
      position: static;
      transform: none;
      border: none;
      border-top: none;
      box-shadow: none;
      background: rgba(0, 0, 0, 0.2);
      width: 100%;
    }

    .nav-links.open .dropdown a {
      padding: 10px 40px;
      font-size: 11px;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-mobile-toggle') as HTMLButtonElement | null;
  const links = document.querySelector('.nav-links') as HTMLElement | null;
  toggle?.addEventListener('click', () => {
    const open = links?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
