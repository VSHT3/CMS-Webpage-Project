<script type="application/json" id="pdf-search-data" set:html={pdfSearchJson} is:inline></script>

<style>
  :root {
    --nav-bg: oklch(0.36 0.04 190);
    --nav-bg-dark: oklch(0.28 0.035 194);
    --nav-text: oklch(0.93 0.016 88);
    --nav-text-dim: oklch(0.82 0.025 88);
    --nav-gold: var(--site-gold);
    --nav-gold-light: oklch(0.84 0.075 88);
    --nav-border: oklch(0.52 0.04 190 / 0.72);
    --nav-logo-h: 92px;
    --nav-font: 'Palatino Linotype', Palatino, 'Book Antiqua', Georgia, serif;
    --nav-ease: var(--site-ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .site-nav-wrapper {
    position: sticky;
    top: 0;
    z-index: var(--site-z-nav, 40);
    background: var(--nav-bg);
    border-bottom: 1px solid var(--nav-border);
    box-shadow: var(--site-shadow);
    color: var(--nav-text);
    isolation: isolate;
  }

  .site-nav {
    display: flex;
    align-items: stretch;
    height: var(--nav-logo-h);
    width: 100%;
    padding: 0 max(0.75rem, env(safe-area-inset-right)) 0 0;
    margin: 0;
    overflow: visible;
    gap: clamp(0.45rem, 1vw, 1rem);
  }

  /* ── Logo ───────────────────────────── */
  .nav-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none !important;
    line-height: 0;
    height: var(--nav-logo-h);
    padding: 0;
  }

  .nav-logo-img {
    display: block;
    height: var(--nav-logo-h);
    width: auto;
    object-fit: contain;
    object-position: left center;
  }

  /* ── Nav links row ──────────────────── */
  .nav-links {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
    min-width: 0;
    overflow: visible;
    scrollbar-width: none;
    gap: 0;
  }

  .nav-links::-webkit-scrollbar {
    display: none;
  }

  /* ── Individual item ────────────────── */
  .nav-item {
    position: relative;
    display: flex;
    align-items: stretch;
    flex: 0 1 auto;
    justify-content: center;
  }

  .nav-link,
  .nav-dropdown-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 100%;
    padding: 0 clamp(0.42rem, 0.75vw, 0.9rem);
    font-family: var(--nav-font);
    font-size: clamp(0.64rem, 0.74vw, 0.83rem);
    font-weight: 600;
    letter-spacing: 0.045em;
    line-height: 1.15;
    text-transform: uppercase;
    color: var(--nav-text) !important;
    text-decoration: none !important;
    white-space: nowrap;
    transition: color 0.2s var(--nav-ease), border-color 0.2s var(--nav-ease);
    border-bottom: 2px solid transparent;
    cursor: pointer;
  }

  .nav-link-group {
    display: flex;
    align-items: stretch;
    height: 100%;
  }

  .nav-parent-link {
    padding-right: 0.25rem;
  }

  .nav-dropdown-toggle {
    width: 1.45rem;
    padding: 0;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    appearance: none;
  }

  .nav-link:hover,
  .nav-item:focus-within .nav-link,
  .nav-item:hover .nav-link {
    color: var(--nav-gold) !important;
    border-bottom-color: var(--nav-gold);
  }

  .nav-dropdown-toggle:hover,
  .nav-item:focus-within .nav-dropdown-toggle,
  .nav-item:hover .nav-dropdown-toggle {
    color: var(--nav-gold) !important;
    border-bottom-color: var(--nav-gold);
  }

  .chevron {
    flex-shrink: 0;
    opacity: 0.65;
    transition: transform 0.2s var(--nav-ease), opacity 0.2s var(--nav-ease);
  }

  .nav-item:hover .chevron,
  .nav-item:focus-within .chevron {
    transform: rotate(180deg);
    opacity: 1;
  }

  /* ── Dropdown panel ─────────────────── */
  .dropdown {
    display: block;
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(0.35rem);
    min-width: max-content;
    width: max-content;
    max-width: min(24rem, calc(100vw - 2rem));
    background: var(--nav-bg-dark);
    border: 1px solid var(--nav-border);
    border-top: 2px solid var(--nav-gold);
    box-shadow: var(--site-shadow);
    list-style: none;
    margin: 0;
    padding: 6px 0;
    z-index: var(--site-z-dropdown, 50);
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition:
      opacity 180ms ease,
      transform 220ms var(--nav-ease),
      visibility 0s linear 220ms;
  }

  .has-dropdown:hover > .dropdown,
  .has-dropdown:focus-within > .dropdown {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
    transition:
      opacity 180ms ease,
      transform 220ms var(--nav-ease),
      visibility 0s linear;
  }

  .dropdown li {
    margin: 0;
    padding: 0;
  }

  .dropdown a {
    display: block;
    padding: 11px 18px;
    font-family: var(--nav-font);
    font-size: 0.79rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--nav-text-dim) !important;
    text-decoration: none !important;
    transition:
      color 0.15s var(--nav-ease),
      background 0.15s var(--nav-ease),
      padding-inline 0.15s var(--nav-ease);
  }

  .dropdown a:hover {
    color: var(--nav-gold-light) !important;
    background: oklch(0.84 0.075 88 / 0.12);
    padding-inline: 22px 14px;
  }

  /* ── Mobile hamburger (simple) ──────── */
  .nav-mobile-toggle {
    display: none;
  }

  .pdf-search {
    position: relative;
    display: flex;
    align-items: center;
    flex: 0 0 auto;
  }

  .pdf-search-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 0.8rem;
    border: 1px solid color-mix(in oklab, var(--nav-border) 72%, transparent);
    border-radius: 0;
    background: transparent;
    color: var(--nav-text);
    font-family: var(--nav-font);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.045em;
    line-height: 1;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      color 180ms var(--nav-ease),
      border-color 180ms var(--nav-ease),
      background-color 180ms var(--nav-ease),
      transform 180ms var(--nav-ease);
  }

  .pdf-search-trigger:hover,
  .pdf-search-trigger:focus-visible,
  .pdf-search.is-open .pdf-search-trigger {
    color: var(--nav-gold);
    border-color: color-mix(in oklab, var(--nav-gold) 64%, transparent);
    background: oklch(0.84 0.075 88 / 0.1);
  }

  .pdf-search-trigger:active {
    transform: translateY(1px);
  }

  .pdf-search-panel {
    position: absolute;
    top: calc(100% + 0.65rem);
    right: 0;
    z-index: var(--site-z-dropdown, 50);
    width: min(30rem, calc(100vw - 1.5rem));
    padding: 1rem;
    border: 1px solid var(--nav-border);
    border-top: 2px solid var(--nav-gold);
    background: var(--nav-bg-dark);
    box-shadow: var(--site-shadow);
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transform: translateY(0.35rem);
    transition:
      opacity 180ms ease,
      transform 220ms var(--nav-ease),
      visibility 0s linear 220ms;
  }

  .pdf-search.is-open .pdf-search-panel {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
    transform: translateY(0);
    transition:
      opacity 180ms ease,
      transform 220ms var(--nav-ease),
      visibility 0s linear;
  }

  .pdf-search-form {
    display: grid;
    gap: 0.55rem;
    margin: 0;
  }

  .pdf-search-label {
    color: var(--nav-gold);
    font-family: var(--nav-font);
    font-size: 0.76rem;
    letter-spacing: 0.12em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .pdf-search-input {
    width: 100%;
    min-height: 2.8rem;
    padding: 0.78rem 0.85rem;
    border: 1px solid color-mix(in oklab, var(--nav-border) 86%, transparent);
    border-radius: 0;
    background: oklch(0.18 0.026 202 / 0.78);
    color: var(--nav-text);
    font: inherit;
    font-size: 1rem;
    line-height: 1.3;
    outline: none;
    transition:
      border-color 180ms var(--nav-ease),
      background-color 180ms var(--nav-ease);
  }

  .pdf-search-input::placeholder {
    color: color-mix(in oklab, var(--nav-text-dim) 72%, transparent);
  }

  .pdf-search-input:focus {
    border-color: var(--nav-gold);
    background: oklch(0.16 0.024 202 / 0.92);
  }

  .pdf-search-status,
  .pdf-search-empty {
    margin: 0.8rem 0 0;
    color: var(--nav-text-dim);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .pdf-search-results {
    display: grid;
    max-height: min(44dvh, 21rem);
    margin: 0.75rem 0 0;
    padding: 0;
    overflow: auto;
    list-style: none;
    border-top: 1px solid color-mix(in oklab, var(--nav-border) 72%, transparent);
  }

  .pdf-search-results:empty {
    display: none;
  }

  :global(.pdf-search-result) {
    padding: 0.75rem 0;
    border-bottom: 1px solid color-mix(in oklab, var(--nav-border) 48%, transparent);
  }

  :global(.pdf-search-result-card) {
    display: grid;
    gap: 0.55rem;
  }

  :global(.pdf-search-result-info) {
    display: grid;
    gap: 0.28rem;
  }

  :global(.pdf-search-result strong) {
    color: var(--nav-text);
    font-family: var(--nav-font);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.28;
    overflow-wrap: break-word;
  }

  :global(.pdf-search-result-source) {
    color: var(--nav-text-dim);
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-wrap: break-word;
  }

  :global(.pdf-search-result-actions) {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  :global(.pdf-search-result-btn) {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.36rem 0.8rem;
    border: 1px solid color-mix(in oklab, var(--nav-border) 72%, transparent);
    border-radius: 0;
    background: transparent;
    color: var(--nav-text-dim) !important;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    line-height: 1;
    text-decoration: none !important;
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      color 150ms var(--nav-ease),
      border-color 150ms var(--nav-ease),
      background-color 150ms var(--nav-ease);
  }

  :global(.pdf-search-result-btn:hover),
  :global(.pdf-search-result-btn:focus-visible) {
    color: var(--nav-gold) !important;
    border-color: color-mix(in oklab, var(--nav-gold) 56%, transparent);
    background: oklch(0.84 0.075 88 / 0.08);
  }

  :global(.pdf-search-result-btn--open) {
    color: var(--nav-gold) !important;
    border-color: color-mix(in oklab, var(--nav-gold) 40%, transparent);
  }

  :global(.pdf-search-result-btn--open:hover),
  :global(.pdf-search-result-btn--open:focus-visible) {
    background: oklch(0.84 0.075 88 / 0.12);
    border-color: var(--nav-gold);
  }

  .hamburger-line {
    display: block;
    width: 24px;
    height: 2px;
    border-radius: 0;
    background: currentColor;
    transform-origin: center;
    transition: transform 220ms var(--nav-ease), opacity 160ms var(--nav-ease);
  }

  @media (max-width: 1380px) {
    :global(body.nav-open) {
      overflow: hidden;
    }

    .nav-links {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      position: fixed;
      top: var(--nav-logo-h);
      left: 0;
      right: 0;
      bottom: auto;
      height: calc(100dvh - var(--nav-logo-h));
      z-index: var(--site-z-nav-panel, 39);
      padding: 12px 0 max(24px, env(safe-area-inset-bottom));
      background: var(--nav-bg-dark);
      overflow-y: auto;
      overflow-x: hidden;
      opacity: 0;
      pointer-events: none;
      visibility: hidden;
      transform: translateY(-14px);
      transition:
        opacity 220ms ease,
        transform 260ms var(--nav-ease),
        visibility 0s linear 260ms;
    }

    .site-nav {
      justify-content: space-between;
      height: var(--nav-logo-h);
      padding-left: 0;
      padding-right: max(0.75rem, env(safe-area-inset-right));
    }

    .nav-mobile-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 5px;
      min-width: 48px;
      min-height: 48px;
      padding: 0;
      background: transparent;
      border: 0;
      border-radius: 0;
      color: var(--nav-text);
      cursor: pointer;
      transition: color 180ms ease, opacity 180ms ease;
    }

    .pdf-search {
      margin-left: auto;
    }

    .pdf-search-trigger {
      width: 48px;
      height: 48px;
      padding: 0;
      border-color: transparent;
      background: transparent;
    }

    .pdf-search-trigger span {
      display: none;
    }

    .pdf-search-panel {
      position: fixed;
      top: var(--nav-logo-h);
      left: 0;
      right: 0;
      width: 100%;
      max-height: calc(100dvh - var(--nav-logo-h));
      padding: 1rem clamp(1rem, 4vw, 1.4rem) max(1.35rem, env(safe-area-inset-bottom));
      overflow: auto;
      border-right: 0;
      border-left: 0;
      transform: translateY(-0.55rem);
    }

    .nav-mobile-toggle:hover,
    .nav-mobile-toggle:focus-visible {
      color: var(--nav-gold);
      opacity: 0.92;
    }

    .nav-mobile-toggle[aria-expanded='true'] .hamburger-line:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .nav-mobile-toggle[aria-expanded='true'] .hamburger-line:nth-child(2) {
      opacity: 0;
      transform: scaleX(0.2);
    }

    .nav-mobile-toggle[aria-expanded='true'] .hamburger-line:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    .nav-links.open {
      opacity: 1;
      pointer-events: auto;
      visibility: visible;
      transform: translateY(0);
      transition:
        opacity 220ms ease,
        transform 260ms var(--nav-ease),
        visibility 0s linear;
    }

    .nav-links.open .nav-item {
      width: 100%;
      flex: 0 0 auto;
      flex-direction: column;
      align-items: flex-start;
    }

    .nav-links.open .nav-link-group {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 3.5rem;
      width: 100%;
      min-height: 52px;
    }

    .nav-links.open .nav-link,
    .nav-links.open .nav-dropdown-toggle {
      width: 100%;
      min-height: 50px;
      padding: 15px clamp(1.1rem, 5vw, 2rem);
      font-size: 14px;
      border-bottom: 1px solid var(--nav-border);
      justify-content: flex-start;
      white-space: normal;
    }

    .nav-links.open .nav-dropdown-toggle {
      justify-content: center;
      padding: 0;
      border-left: 1px solid var(--nav-border);
    }

    .nav-links.open .dropdown {
      display: block;
      position: static;
      transform: none;
      border: none;
      border-top: none;
      box-shadow: none;
      background: oklch(0.2 0.03 198 / 0.72);
      width: 100%;
      padding: 0;
      overflow: hidden;
      max-height: 0;
      opacity: 0;
      visibility: hidden;
      transition:
        grid-template-rows 260ms var(--nav-ease),
        max-height 260ms var(--nav-ease),
        opacity 180ms ease,
        visibility 0s linear 260ms;
    }

    .nav-links.open .nav-item:hover .chevron,
    .nav-links.open .nav-item:focus-within .chevron {
      transform: none;
      opacity: 0.65;
    }

    .nav-links.open .has-dropdown.is-expanded > .dropdown {
      max-height: none;
      opacity: 1;
      visibility: visible;
      transition:
        opacity 180ms ease,
        visibility 0s linear;
    }

    .nav-links.open .has-dropdown.is-expanded > .nav-link-group .chevron {
      transform: rotate(180deg);
      opacity: 1;
    }

    .nav-links.open .dropdown li:first-child {
      padding-top: 6px;
    }

    .nav-links.open .dropdown li:last-child {
      padding-bottom: 6px;
    }

    .nav-links.open .dropdown a {
      min-height: 44px;
      padding: 12px clamp(2rem, 9vw, 3.25rem);
      font-size: 0.875rem;
      line-height: 1.35;
      white-space: normal;
    }
  }

  @media (max-width: 560px) {
    :root {
      --nav-logo-h: 72px;
    }

    .nav-logo-img {
      width: auto;
      max-width: none;
      object-position: left center;
    }

    .nav-links.open {
      top: var(--nav-logo-h);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-links,
    .dropdown,
    .pdf-search-panel,
    .pdf-search-trigger,
    .hamburger-line,
    .nav-mobile-toggle,
    .nav-dropdown-toggle {
      transition: none;
    }

    :global(.pdf-search-result-btn) {
      transition: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-mobile-toggle') as HTMLButtonElement | null;
  const links = document.querySelector('#site-nav-links') as HTMLElement | null;
  const docBody = document.body;
  const pdfSearch = document.querySelector<HTMLElement>('[data-pdf-search]');
  const pdfSearchTrigger = document.querySelector<HTMLButtonElement>('[data-pdf-search-trigger]');
  const pdfSearchPanel = document.querySelector<HTMLElement>('#pdf-search-panel');
  const pdfSearchInput = document.querySelector<HTMLInputElement>('[data-pdf-search-input]');
  const pdfSearchForm = document.querySelector<HTMLFormElement>('[data-pdf-search-form]');
  const pdfSearchStatus = document.querySelector<HTMLElement>('[data-pdf-search-status]');
  const pdfSearchResults = document.querySelector<HTMLElement>('[data-pdf-search-results]');
  const pdfSearchEmpty = document.querySelector<HTMLElement>('[data-pdf-search-empty]');
  const pdfSearchData = document.querySelector<HTMLScriptElement>('#pdf-search-data');

  type PdfSearchItem = {
    title: string;
    filename: string;
    displayFilename: string;
    href: string;
    sourcePage: string;
    sourcePath: string;
    search: string;
  };

  const pdfItems: PdfSearchItem[] = JSON.parse(pdfSearchData?.textContent || '[]');

  const setMenuState = (open: boolean) => {
    links?.classList.toggle('open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    docBody.classList.toggle('nav-open', open);

    document.querySelectorAll<HTMLElement>('.has-dropdown.is-expanded').forEach((item) => {
      item.classList.remove('is-expanded');
    });
    document
      .querySelectorAll<HTMLButtonElement>('.nav-dropdown-toggle[aria-expanded="true"]')
      .forEach((trigger) => trigger.setAttribute('aria-expanded', 'false'));
  };

  const normalizePdfQuery = (value = '') =>
    value
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[_./-]+/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();

  const slugifyHeading = (text: string) =>
    text
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');

  const renderPdfResults = () => {
    if (!pdfSearchInput || !pdfSearchResults || !pdfSearchStatus || !pdfSearchEmpty) {
      return;
    }

    const query = normalizePdfQuery(pdfSearchInput.value);
    pdfSearchResults.replaceChildren();

    if (!query) {
      pdfSearchStatus.textContent = `${pdfItems.length} publications indexed. Type a title, report, catalogue, author, or year.`;
      pdfSearchEmpty.hidden = true;
      return;
    }

    const terms = query.split(' ').filter(Boolean);
    const matches = pdfItems
      .map((item) => {
        if (!terms.every((term) => item.search.includes(term))) {
          return null;
        }

        let score = 0;
        const title = normalizePdfQuery(item.title);
        const filename = normalizePdfQuery(item.filename);
        const source = normalizePdfQuery(item.sourcePage);

        terms.forEach((term) => {
          if (title.startsWith(term)) score += 18;
          if (filename.startsWith(term)) score += 14;
          if (title.includes(term)) score += 8;
          if (filename.includes(term)) score += 6;
          if (source.includes(term)) score += 3;
        });

        return { item, score };
      })
      .filter((match): match is { item: PdfSearchItem; score: number } => Boolean(match))
      .sort((first, second) => second.score - first.score || first.item.title.localeCompare(second.item.title));

    const fragment = document.createDocumentFragment();

    matches.forEach(({ item }) => {
      const result = document.createElement('li');
      result.className = 'pdf-search-result';

      const card = document.createElement('div');
      card.className = 'pdf-search-result-card';

      const info = document.createElement('div');
      info.className = 'pdf-search-result-info';

      const titleEl = document.createElement('strong');
      titleEl.textContent = item.title;

      const sourceEl = document.createElement('span');
      sourceEl.className = 'pdf-search-result-source';
      sourceEl.textContent = item.sourcePage;

      info.append(titleEl, sourceEl);

      const actions = document.createElement('div');
      actions.className = 'pdf-search-result-actions';

      const pageBtn = document.createElement('a');
      const headingSlug = slugifyHeading(item.title);
      pageBtn.href = `${item.sourcePath || '/'}${headingSlug ? '#' + headingSlug : ''}`;
      pageBtn.className = 'pdf-search-result-btn pdf-search-result-btn--page';
      pageBtn.textContent = 'View on page';

      const openBtn = document.createElement('a');
      openBtn.href = item.href;
      openBtn.target = '_blank';
      openBtn.rel = 'noopener noreferrer';
      openBtn.className = 'pdf-search-result-btn pdf-search-result-btn--open';
      openBtn.textContent = 'Open document';

      actions.append(pageBtn, openBtn);
      card.append(info, actions);
      result.append(card);
      fragment.append(result);
    });

    pdfSearchResults.append(fragment);
    pdfSearchEmpty.hidden = matches.length > 0;
    pdfSearchStatus.textContent =
      matches.length === 1 ? '1 publication found.' : `${matches.length} publications found.`;
  };

  const setSearchState = (open: boolean) => {
    pdfSearch?.classList.toggle('is-open', open);
    pdfSearchTrigger?.setAttribute('aria-expanded', String(open));
    pdfSearchPanel?.setAttribute('aria-hidden', String(!open));
    pdfSearchPanel?.toggleAttribute('inert', !open);

    if (open) {
      setMenuState(false);
      renderPdfResults();
      window.requestAnimationFrame(() => pdfSearchInput?.focus());
    }
  };

  toggle?.addEventListener('click', () => {
    setSearchState(false);
    setMenuState(!(links?.classList.contains('open') ?? false));
  });

  pdfSearchTrigger?.addEventListener('click', () => {
    setSearchState(!(pdfSearch?.classList.contains('is-open') ?? false));
  });

  pdfSearchInput?.addEventListener('input', renderPdfResults);

  pdfSearchForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    pdfSearchResults?.querySelector<HTMLAnchorElement>('.pdf-search-result-btn--open')?.click();
  });

  document.addEventListener('click', (event) => {
    const target = event.target as Node | null;
    if (target && pdfSearch?.classList.contains('is-open') && !pdfSearch.contains(target)) {
      setSearchState(false);
    }
  });

  links?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    const mobileMenu = window.matchMedia('(max-width: 1380px)').matches;
    const dropdownTrigger = target?.closest<HTMLButtonElement>('[data-dropdown-trigger]');

    if (mobileMenu && dropdownTrigger) {
      event.preventDefault();
      const item = dropdownTrigger.closest<HTMLElement>('.has-dropdown');
      const expanded = !(item?.classList.contains('is-expanded') ?? false);

      item?.classList.toggle('is-expanded', expanded);
      dropdownTrigger.setAttribute('aria-expanded', String(expanded));
      return;
    }

    if (mobileMenu && target?.closest('a')) {
      setMenuState(false);
    }
  });

  window.addEventListener('resize', () => {
    if (!window.matchMedia('(max-width: 1380px)').matches) {
      setMenuState(false);
    }
  });

  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setSearchState(false);
      setMenuState(false);
      document
        .querySelectorAll<HTMLButtonElement>('.nav-dropdown-toggle[aria-expanded="true"]')
        .forEach((trigger) => trigger.setAttribute('aria-expanded', 'false'));
    }
  });

  document.querySelectorAll<HTMLElement>('.has-dropdown').forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>(':scope .nav-dropdown-toggle[aria-haspopup="true"]');

    const setExpanded = (expanded: boolean) => {
      if (window.matchMedia('(max-width: 1380px)').matches) {
        return;
      }
      trigger?.setAttribute('aria-expanded', String(expanded));
    };

    item.addEventListener('pointerenter', () => setExpanded(true));
    item.addEventListener('pointerleave', () => setExpanded(false));
    item.addEventListener('focusin', () => setExpanded(true));
    item.addEventListener('focusout', (event) => {
      if (!item.contains(event.relatedTarget as Node | null)) {
        setExpanded(false);
      }
    });
  });
</script>
