---
import { buildSiteSearchIndex } from '../lib/site-search';

const siteSearchItems = buildSiteSearchIndex();
const siteSearchJson = JSON.stringify(siteSearchItems).replace(/</g, '\\u003c');
---
<header class="site-nav-wrapper">
  <nav class="site-nav" role="navigation" aria-label="Main navigation">
    <a href="/" class="nav-logo" aria-label="Center for Mesoamerican Studies, Home">
      <img src="/navimg.png" alt="Center for Mesoamerican Studies" class="nav-logo-img" />
    </a>

    <ul class="nav-links" id="site-nav-links" role="list">

      <li class="nav-item">
        <a href="/" class="nav-link">Home</a>
      </li>

      <li class="nav-item has-dropdown">
        <div class="nav-link-group">
          <a href="/about-us" class="nav-link nav-parent-link">About Us</a>
          <button class="nav-dropdown-toggle" type="button" aria-label="Toggle About Us menu" aria-haspopup="true" aria-expanded="false" data-dropdown-trigger>
          <svg class="chevron" viewBox="0 0 16 16" width="11" height="11" aria-hidden="true">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m4 6 4 4 4-4"/>
          </svg>
          </button>
        </div>
        <div class="dropdown">
          <ul class="dropdown-inner" role="list">
          <li><a href="/about-us">Overview</a></li>
          <li><a href="/abouts-us-members">Members</a></li>
          <li><a href="/about-us-contacts">Contacts</a></li>
          </ul>
        </div>
      </li>

      <li class="nav-item has-dropdown">
        <div class="nav-link-group">
          <a href="/bratislava-maya-meetings-history" class="nav-link nav-parent-link">Conferences</a>
          <button class="nav-dropdown-toggle" type="button" aria-label="Toggle Conferences menu" aria-haspopup="true" aria-expanded="false" data-dropdown-trigger>
          <svg class="chevron" viewBox="0 0 16 16" width="11" height="11" aria-hidden="true">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m4 6 4 4 4-4"/>
          </svg>
          </button>
        </div>
        <div class="dropdown">
          <ul class="dropdown-inner" role="list">
          <li><a href="/bratislava-maya-meetings-history">History</a></li>
          <li><a href="/bratislava-maya-meetings-news">News</a></li>
          <li><a href="/bratislava-maya-meetings-gallery">Gallery</a></li>
          </ul>
        </div>
      </li>

      <li class="nav-item has-dropdown">
        <div class="nav-link-group">
          <a href="/ferdinand-anders-library" class="nav-link nav-parent-link">Library</a>
          <button class="nav-dropdown-toggle" type="button" aria-label="Toggle Library menu" aria-haspopup="true" aria-expanded="false" data-dropdown-trigger>
          <svg class="chevron" viewBox="0 0 16 16" width="11" height="11" aria-hidden="true">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m4 6 4 4 4-4"/>
          </svg>
          </button>
        </div>
        <div class="dropdown">
          <ul class="dropdown-inner" role="list">
          <li><a href="/ferdinand-anders-library">Ferdinand Anders Library</a></li>
          <li><a href="/ferdinand-anders-library-history">History</a></li>
          <li><a href="/ferdinand-anders-library-catalogue">Catalogue</a></li>
          </ul>
        </div>
      </li>

      <li class="nav-item has-dropdown">
        <div class="nav-link-group">
          <a href="/research" class="nav-link nav-parent-link">Research</a>
          <button class="nav-dropdown-toggle" type="button" aria-label="Toggle Research menu" aria-haspopup="true" aria-expanded="false" data-dropdown-trigger>
          <svg class="chevron" viewBox="0 0 16 16" width="11" height="11" aria-hidden="true">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m4 6 4 4 4-4"/>
          </svg>
          </button>
        </div>
        <div class="dropdown">
          <ul class="dropdown-inner" role="list">
          <li><a href="/research">Overview</a></li>
          <li><a href="/grants-and-investigations-grants">Grants</a></li>
          <li><a href="/grants-and-investigations">Project Reports</a></li>
          <li><a href="/grants-and-investigations-investigation-notes">Investigation Notes</a></li>
          <li><a href="/grants-and-investigations-gallery">Gallery</a></li>
          </ul>
        </div>
      </li>

      <li class="nav-item has-dropdown">
        <div class="nav-link-group">
          <a href="/collection-archaeological-collection" class="nav-link nav-parent-link">Collections</a>
          <button class="nav-dropdown-toggle" type="button" aria-label="Toggle Collections menu" aria-haspopup="true" aria-expanded="false" data-dropdown-trigger>
          <svg class="chevron" viewBox="0 0 16 16" width="11" height="11" aria-hidden="true">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m4 6 4 4 4-4"/>
          </svg>
          </button>
        </div>
        <div class="dropdown">
          <ul class="dropdown-inner" role="list">
          <li><a href="/collection-archaeological-collection">Archaeological Collection</a></li>
          <li><a href="/collections-ethnographical-collection">Ethnographical Collection</a></li>
          <li><a href="/exhibitions">Exhibitions</a></li>
          <li><a href="/collections-gallery">Gallery</a></li>
          </ul>
        </div>
      </li>

      <li class="nav-item">
        <a href="/publications" class="nav-link">Publications</a>
      </li>

      <li class="nav-item has-dropdown">
        <div class="nav-link-group">
          <a href="/paru-uaxactun-papers" class="nav-link nav-parent-link">PARU Uaxactun</a>
          <button class="nav-dropdown-toggle" type="button" aria-label="Toggle PARU Uaxactun menu" aria-haspopup="true" aria-expanded="false" data-dropdown-trigger>
          <svg class="chevron" viewBox="0 0 16 16" width="11" height="11" aria-hidden="true">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m4 6 4 4 4-4"/>
          </svg>
          </button>
        </div>
        <div class="dropdown">
          <ul class="dropdown-inner" role="list">
          <li><a href="/paru-uaxactun-history">History</a></li>
          <li><a href="/paru-uaxactun-maps">Maps</a></li>
          <li><a href="/paru-uaxactun-papers">Archaeological Reports</a></li>
          <li><a href="/paru-uaxactun-gallery">Gallery</a></li>
          <li><a href="/paru-uaxactun-recent-investigations">Recent Investigations</a></li>
          <li><a href="/paru-uaxactun-archeological-artefacts">Archaeological Artefacts</a></li>
          </ul>
        </div>
      </li>

      <li class="nav-item has-dropdown">
        <div class="nav-link-group">
          <a href="/education-phd-program" class="nav-link nav-parent-link">Education</a>
          <button class="nav-dropdown-toggle" type="button" aria-label="Toggle Education menu" aria-haspopup="true" aria-expanded="false" data-dropdown-trigger>
          <svg class="chevron" viewBox="0 0 16 16" width="11" height="11" aria-hidden="true">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m4 6 4 4 4-4"/>
          </svg>
          </button>
        </div>
        <div class="dropdown">
          <ul class="dropdown-inner" role="list">
          <li><a href="/education-phd-program">PhD Program</a></li>
          <li><a href="/education-published-thesis">Published Thesis</a></li>
          <li><a href="/education-work-in-progress">Work in Progress</a></li>
          <li><a href="/education-gallery">Gallery</a></li>
          </ul>
        </div>
      </li>

    </ul>

    <div class="site-search" data-site-search>
      <button
        class="site-search-trigger"
        type="button"
        aria-label="Search site"
        aria-controls="site-search-panel"
        aria-expanded="false"
        data-site-search-trigger
      >
        <svg class="site-search-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="m21 21-4.35-4.35" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"></path>
          <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
        </svg>
        <span>Search site</span>
      </button>

      <section
        class="site-search-panel"
        id="site-search-panel"
        aria-label="Search site"
        aria-hidden="true"
        inert
      >
        <form class="site-search-form" role="search" data-site-search-form>
          <label class="site-search-label" for="site-search-input">Search site</label>
          <input
            id="site-search-input"
            class="site-search-input"
            type="search"
            autocomplete="off"
            placeholder="Search pages, databases, reports, authors, or years"
            data-site-search-input
          />
        </form>
        <p class="site-search-status" aria-live="polite" data-site-search-status></p>
        <ul class="site-search-results" id="site-search-results" role="list" data-site-search-results></ul>
        <p class="site-search-empty" hidden data-site-search-empty>No matching pages or documents.</p>
      </section>
    </div>

    <button
      class="nav-mobile-toggle"
      type="button"
      aria-label="Toggle menu"
      aria-controls="site-nav-links"
      aria-expanded="false"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </nav>
  <div class="nav-scrim" aria-hidden="true" data-nav-scrim></div>
</header>

<script type="application/json" id="site-search-data" set:html={siteSearchJson} is:inline></script>

<style>
  :root {
    --nav-bg: oklch(0.36 0.04 190);
    --nav-bg-dark: oklch(0.28 0.035 194);
    --nav-text: oklch(0.93 0.016 88);
    --nav-text-dim: oklch(0.82 0.025 88);
    --nav-gold: var(--site-gold);
    --nav-gold-light: oklch(0.84 0.075 88);
    --nav-border: oklch(0.52 0.04 190 / 0.72);
    --nav-scrim: oklch(0.1 0.018 204 / 0.5);
    --nav-sheet-shadow: oklch(0.1 0.018 204 / 0.28);
    --nav-logo-h: 92px;
    --nav-font: var(--site-font-display);
    --nav-ease: var(--site-ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .site-nav-wrapper {
    position: sticky;
    top: 0;
    z-index: var(--site-z-nav, 40);
    background: var(--nav-bg);
    border-bottom: 1px solid var(--nav-border);
    box-shadow: var(--site-shadow);
    color: var(--nav-text);
    isolation: isolate;
  }

  .site-nav {
    display: flex;
    align-items: stretch;
    height: var(--nav-logo-h);
    width: 100%;
    padding: 0 max(0.75rem, env(safe-area-inset-right)) 0 0;
    margin: 0;
    overflow: visible;
    gap: clamp(0.45rem, 1vw, 1rem);
  }

  /* ── Logo ───────────────────────────── */
  .nav-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none !important;
    line-height: 0;
    height: var(--nav-logo-h);
    padding: 0;
  }

  .nav-logo-img {
    display: block;
    height: var(--nav-logo-h);
    width: auto;
    object-fit: contain;
    object-position: left center;
  }

  /* ── Nav links row ──────────────────── */
  .nav-links {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
    min-width: 0;
    overflow: visible;
    scrollbar-width: none;
    gap: 0;
  }

  .nav-links::-webkit-scrollbar {
    display: none;
  }

  /* ── Individual item ────────────────── */
  .nav-item {
    position: relative;
    display: flex;
    align-items: stretch;
    flex: 0 1 auto;
    min-width: max-content;
    justify-content: center;
  }

  .nav-link,
  .nav-dropdown-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 100%;
    padding: 0 clamp(0.42rem, 0.75vw, 0.9rem);
    font-family: var(--nav-font);
    font-size: clamp(0.64rem, 0.74vw, 0.83rem);
    font-weight: 600;
    letter-spacing: 0.045em;
    line-height: 1.15;
    text-transform: uppercase;
    color: var(--nav-text) !important;
    text-decoration: none !important;
    white-space: nowrap;
    transition: color 0.2s var(--nav-ease), border-color 0.2s var(--nav-ease);
    border-bottom: 2px solid transparent;
    cursor: pointer;
  }

  .nav-link-group {
    display: flex;
    align-items: stretch;
    height: 100%;
  }

  .nav-parent-link {
    padding-right: 0.25rem;
  }

  .nav-dropdown-toggle {
    width: 1.45rem;
    padding: 0;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    appearance: none;
  }

  .nav-link:hover,
  .nav-item:focus-within .nav-link,
  .nav-item:hover .nav-link {
    color: var(--nav-gold) !important;
    border-bottom-color: var(--nav-gold);
  }

  .nav-dropdown-toggle:hover,
  .nav-item:focus-within .nav-dropdown-toggle,
  .nav-item:hover .nav-dropdown-toggle {
    color: var(--nav-gold) !important;
    border-bottom-color: var(--nav-gold);
  }

  .chevron {
    flex-shrink: 0;
    opacity: 0.65;
    transition: transform 0.2s var(--nav-ease), opacity 0.2s var(--nav-ease);
  }

  .nav-item:hover .chevron,
  .nav-item:focus-within .chevron {
    transform: rotate(180deg);
    opacity: 1;
  }

  /* ── Dropdown panel ─────────────────── */
  .dropdown {
    display: block;
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(0.35rem);
    min-width: max-content;
    width: max-content;
    max-width: min(24rem, calc(100vw - 2rem));
    background: var(--nav-bg-dark);
    border: 1px solid var(--nav-border);
    border-top: 2px solid var(--nav-gold);
    box-shadow: var(--site-shadow);
    list-style: none;
    margin: 0;
    padding: 6px 0;
    z-index: var(--site-z-dropdown, 50);
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition:
      opacity 180ms ease,
      transform 220ms var(--nav-ease),
      visibility 0s linear 220ms;
  }

  .has-dropdown:hover > .dropdown,
  .has-dropdown:focus-within > .dropdown {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
    transition:
      opacity 180ms ease,
      transform 220ms var(--nav-ease),
      visibility 0s linear;
  }

  /* Search and navigation dropdowns share the same top-layer space. */
  .site-nav.has-open-search .dropdown {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transform: translateX(-50%) translateY(0.35rem);
    transition: none;
  }

  /* .dropdown-inner: transparent passthrough on desktop, grid child on mobile */
  .dropdown-inner {
    display: contents;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .dropdown li {
    margin: 0;
    padding: 0;
  }

  .dropdown a {
    display: block;
    padding: 11px 18px;
    font-family: var(--nav-font);
    font-size: 0.79rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--nav-text-dim) !important;
    text-decoration: none !important;
    transition:
      color 0.15s var(--nav-ease),
      background 0.15s var(--nav-ease),
      padding-inline 0.15s var(--nav-ease);
  }

  .dropdown a:hover {
    color: var(--nav-gold-light) !important;
    background: oklch(0.84 0.075 88 / 0.12);
    padding-inline: 22px 14px;
  }

  /* ── Mobile hamburger (simple) ──────── */
  .nav-mobile-toggle {
    display: none;
  }

  .site-search {
    position: relative;
    display: flex;
    align-items: center;
    flex: 0 0 auto;
  }

  .site-search-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 0.8rem;
    border: 1px solid color-mix(in oklab, var(--nav-border) 72%, transparent);
    border-radius: 0;
    background: transparent;
    color: var(--nav-text);
    font-family: var(--nav-font);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.045em;
    line-height: 1;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      color 180ms var(--nav-ease),
      border-color 180ms var(--nav-ease),
      background-color 180ms var(--nav-ease),
      transform 180ms var(--nav-ease);
  }

  .site-search-trigger:hover,
  .site-search-trigger:focus-visible,
  .site-search.is-open .site-search-trigger {
    color: var(--nav-gold);
    border-color: color-mix(in oklab, var(--nav-gold) 64%, transparent);
    background: oklch(0.84 0.075 88 / 0.1);
  }

  .site-search-trigger:active {
    transform: translateY(1px);
  }

  .site-search-panel {
    position: absolute;
    top: calc(100% + 0.65rem);
    right: 0;
    z-index: var(--site-z-dropdown, 50);
    width: min(30rem, calc(100vw - 1.5rem));
    padding: 1rem;
    border: 1px solid var(--nav-border);
    border-top: 2px solid var(--nav-gold);
    background: var(--nav-bg-dark);
    box-shadow: var(--site-shadow);
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transform: translateY(0.35rem);
    transition:
      opacity 180ms ease,
      transform 220ms var(--nav-ease),
      visibility 0s linear 220ms;
  }

  .site-search.is-open .site-search-panel {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
    transform: translateY(0);
    transition:
      opacity 180ms ease,
      transform 220ms var(--nav-ease),
      visibility 0s linear;
  }

  .site-search-form {
    display: grid;
    gap: 0.55rem;
    margin: 0;
  }

  .site-search-label {
    color: var(--nav-gold);
    font-family: var(--nav-font);
    font-size: 0.76rem;
    letter-spacing: 0.12em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .site-search-input {
    width: 100%;
    min-height: 2.8rem;
    padding: 0.78rem 0.85rem;
    border: 1px solid color-mix(in oklab, var(--nav-border) 86%, transparent);
    border-radius: 0;
    background: oklch(0.18 0.026 202 / 0.78);
    color: var(--nav-text);
    font: inherit;
    font-size: 1rem;
    line-height: 1.3;
    outline: none;
    transition:
      border-color 180ms var(--nav-ease),
      background-color 180ms var(--nav-ease);
  }

  .site-search-input::placeholder {
    color: color-mix(in oklab, var(--nav-text-dim) 72%, transparent);
  }

  .site-search-input:focus {
    border-color: var(--nav-gold);
    background: oklch(0.16 0.024 202 / 0.92);
  }

  .site-search-status,
  .site-search-empty {
    margin: 0.8rem 0 0;
    color: var(--nav-text-dim);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .site-search-status:empty {
    display: none;
  }

  .site-search-results {
    display: grid;
    max-height: min(44dvh, 21rem);
    margin: 0.75rem 0 0;
    padding: 0;
    overflow: auto;
    list-style: none;
    border-top: 1px solid color-mix(in oklab, var(--nav-border) 72%, transparent);
  }

  .site-search-results:empty {
    display: none;
  }

  :global(.site-search-result) {
    padding: 0.75rem 0;
    border-bottom: 1px solid color-mix(in oklab, var(--nav-border) 48%, transparent);
  }

  :global(.site-search-result-card) {
    display: grid;
    gap: 0.55rem;
  }

  :global(.site-search-result-info) {
    display: grid;
    gap: 0.28rem;
  }

  :global(.site-search-result strong) {
    color: var(--nav-text);
    font-family: var(--nav-font);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.28;
    overflow-wrap: break-word;
  }

  :global(.site-search-result-context),
  :global(.site-search-result-description) {
    color: var(--nav-text-dim);
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-wrap: break-word;
  }

  :global(.site-search-result-description) {
    margin: 0;
  }

  :global(.site-search-result-actions) {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  :global(.site-search-result-btn) {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    gap: 0.3rem;
    padding: 0.36rem 0.8rem;
    border: 1px solid color-mix(in oklab, var(--nav-border) 72%, transparent);
    border-radius: 0;
    background: transparent;
    color: var(--nav-text-dim) !important;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    line-height: 1;
    text-decoration: none !important;
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      color 150ms var(--nav-ease),
      border-color 150ms var(--nav-ease),
      background-color 150ms var(--nav-ease);
  }

  :global(.site-search-result-btn:hover),
  :global(.site-search-result-btn:focus-visible) {
    color: var(--nav-gold) !important;
    border-color: color-mix(in oklab, var(--nav-gold) 56%, transparent);
    background: oklch(0.84 0.075 88 / 0.08);
  }

  :global(.site-search-result-btn--open) {
    color: var(--nav-gold) !important;
    border-color: color-mix(in oklab, var(--nav-gold) 40%, transparent);
  }

  :global(.site-search-result-btn--open:hover),
  :global(.site-search-result-btn--open:focus-visible) {
    background: oklch(0.84 0.075 88 / 0.12);
    border-color: var(--nav-gold);
  }

  .hamburger-line {
    display: block;
    width: 24px;
    height: 2px;
    border-radius: 0;
    background: currentColor;
    transform-origin: center;
    transition: transform 220ms var(--nav-ease), opacity 160ms var(--nav-ease);
  }

  /*
    Compact desktop: MacBook and embedded-preview widths keep the complete
    navigation visible without shrinking its type below the existing minimum.
    The logo is only slightly shorter and search becomes its icon control.
  */
  @media (min-width: 1251px) and (max-width: 1680px) {
    :root {
      --nav-logo-h: 84px;
    }

    .site-nav {
      gap: clamp(0.2rem, 0.35vw, 0.4rem);
      padding-right: max(0.5rem, env(safe-area-inset-right));
    }

    .nav-link {
      padding-inline: clamp(0.28rem, 0.38vw, 0.4rem);
      font-size: clamp(0.64rem, 0.7vw, 0.75rem);
      letter-spacing: 0.035em;
    }

    .nav-parent-link {
      padding-right: 0.125rem;
    }

    .nav-dropdown-toggle {
      width: 1.1rem;
    }

    .site-search-trigger {
      width: 44px;
      height: 44px;
      min-width: 44px;
      padding: 0;
    }

    .site-search-trigger span {
      display: none;
    }
  }

  .nav-scrim {
    position: fixed;
    inset: var(--nav-logo-h) 0 0;
    z-index: calc(var(--site-z-nav-panel, 39) - 1);
    background: var(--nav-scrim);
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition:
      opacity 220ms ease,
      visibility 0s linear 220ms;
  }

  @media (max-width: 1250px) {
    :global(body.nav-open) {
      overflow: hidden;
    }

    .nav-scrim.is-open {
      opacity: 1;
      pointer-events: auto;
      visibility: visible;
      transition:
        opacity 220ms ease,
        visibility 0s linear;
    }

    /* Right-side sheet keeps page context visible on tablets and laptops. */
    .nav-links {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      position: fixed;
      top: var(--nav-logo-h);
      right: 0;
      bottom: 0;
      left: auto;
      z-index: var(--site-z-nav-panel, 39);
      width: min(29rem, calc(100vw - 3.5rem));
      height: auto;
      padding: 0 env(safe-area-inset-right) 0 0;
      background: var(--nav-bg-dark);
      border-left: 1px solid color-mix(in oklab, var(--nav-border) 88%, var(--nav-bg-dark));
      box-shadow: -8px 0 8px var(--nav-sheet-shadow);
      overflow-y: auto;
      overflow-x: hidden;
      opacity: 0;
      pointer-events: none;
      visibility: hidden;
      transform: translateX(100%);
      transition:
        opacity 180ms ease,
        transform 280ms var(--nav-ease),
        visibility 0s linear 280ms;
    }

    .site-nav {
      justify-content: space-between;
      height: var(--nav-logo-h);
      padding-left: 0;
      padding-right: max(0.75rem, env(safe-area-inset-right));
    }

    .nav-mobile-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 5px;
      min-width: 48px;
      min-height: 48px;
      padding: 0;
      background: transparent;
      border: 0;
      border-radius: 0;
      color: var(--nav-text);
      cursor: pointer;
      transition: color 200ms ease;
    }

    .nav-mobile-toggle:hover,
    .nav-mobile-toggle:focus-visible {
      color: var(--nav-gold);
    }

    .nav-mobile-toggle[aria-expanded='true'] {
      color: var(--nav-gold);
    }

    .nav-mobile-toggle[aria-expanded='true'] .hamburger-line:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .nav-mobile-toggle[aria-expanded='true'] .hamburger-line:nth-child(2) {
      opacity: 0;
      transform: scaleX(0.15);
    }

    .nav-mobile-toggle[aria-expanded='true'] .hamburger-line:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    .site-search {
      margin-left: auto;
    }

    .site-search-trigger {
      width: 48px;
      height: 48px;
      padding: 0;
      border-color: transparent;
      background: transparent;
    }

    .site-search-trigger span {
      display: none;
    }

    .site-search-panel {
      position: fixed;
      top: var(--nav-logo-h);
      right: 0;
      left: 0;
      width: 100%;
      max-height: calc(100dvh - var(--nav-logo-h));
      padding: 1rem clamp(1rem, 4vw, 1.4rem) max(1.35rem, env(safe-area-inset-bottom));
      overflow: auto;
      border-right: 0;
      border-left: 0;
      transform: translateY(-0.55rem);
    }

    .nav-links.open {
      opacity: 1;
      pointer-events: auto;
      visibility: visible;
      transform: translateX(0);
      transition:
        opacity 180ms ease,
        transform 280ms var(--nav-ease),
        visibility 0s linear;
    }

    .nav-links.open .nav-item {
      width: 100%;
      min-width: 0;
      flex: 0 0 auto;
      flex-direction: column;
      align-items: stretch;
      position: relative;
    }

    .nav-links.open .nav-link-group {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 3rem;
      width: 100%;
      min-height: 52px;
      align-items: stretch;
    }

    .nav-links.open .nav-link,
    .nav-links.open .nav-dropdown-toggle {
      width: 100%;
      min-height: 52px;
      padding: 0 1.25rem;
      font-family: var(--nav-font);
      font-size: 0.94rem;
      font-weight: 600;
      letter-spacing: 0.045em;
      text-transform: uppercase;
      line-height: 1.2;
      color: var(--nav-text) !important;
      text-decoration: none !important;
      border: none;
      border-bottom: 1px solid oklch(0.52 0.04 190 / 0.28);
      background: transparent;
      justify-content: flex-start;
      white-space: normal;
      cursor: pointer;
      transition: color 160ms ease, background 160ms ease;
    }

    .nav-links.open .nav-link:hover,
    .nav-links.open .nav-link:focus-visible {
      color: var(--nav-gold) !important;
      background: oklch(0.84 0.075 88 / 0.05);
    }

    .nav-links.open .nav-item:not(.has-dropdown) .nav-link {
      grid-column: 1 / -1;
    }

    .nav-links.open .nav-dropdown-toggle {
      padding: 0;
      justify-content: center;
      align-items: center;
      min-width: 3rem;
      border-bottom: 1px solid oklch(0.52 0.04 190 / 0.28);
      color: var(--nav-text-dim) !important;
      transition: color 160ms ease, background 160ms ease;
    }

    .nav-links.open .nav-dropdown-toggle:hover,
    .nav-links.open .nav-dropdown-toggle:focus-visible {
      color: var(--nav-gold) !important;
      background: oklch(0.84 0.075 88 / 0.05);
    }

    .nav-links.open .nav-item:hover .chevron,
    .nav-links.open .nav-item:focus-within .chevron {
      transform: none;
      opacity: 0.65;
    }

    .nav-links.open .has-dropdown.is-expanded > .nav-link-group .chevron {
      transform: rotate(180deg);
      opacity: 1;
    }

    .nav-links.open .dropdown {
      display: grid;
      grid-template-rows: 0fr;
      flex-shrink: 0;
      position: static;
      transform: none;
      border: none;
      border-top: none;
      box-shadow: none;
      background: oklch(0.19 0.028 200 / 0.8);
      width: 100%;
      padding: 0;
      opacity: 0;
      visibility: hidden;
      overflow: hidden;
      transition:
        grid-template-rows 280ms var(--nav-ease),
        opacity 220ms ease,
        visibility 0s linear 280ms;
    }

    .nav-links.open .dropdown-inner {
      display: block;
      overflow: hidden;
    }

    .nav-links.open .has-dropdown.is-expanded > .dropdown {
      grid-template-rows: 1fr;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition:
        grid-template-rows 280ms var(--nav-ease),
        opacity 200ms ease 40ms,
        visibility 0s linear;
    }

    .nav-links.open .dropdown li {
      padding: 0;
    }

    .nav-links.open .dropdown a {
      display: flex;
      align-items: center;
      min-height: 46px;
      padding: 0 1.75rem;
      font-family: var(--nav-font);
      font-size: 0.79rem;
      font-weight: 400;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      line-height: 1.35;
      white-space: normal;
      color: var(--nav-text-dim) !important;
      text-decoration: none !important;
      border-bottom: 1px solid oklch(0.52 0.04 190 / 0.18);
      transition: color 150ms ease, background 150ms ease, padding-left 150ms ease;
    }

    .nav-links.open .dropdown a:hover,
    .nav-links.open .dropdown a:focus-visible {
      color: var(--nav-gold-light) !important;
      background: oklch(0.84 0.075 88 / 0.07);
      padding-left: 2rem;
    }

    .nav-links.open .dropdown li:last-child a {
      border-bottom: none;
    }

    .nav-links.open::after {
      content: '';
      display: block;
      flex-shrink: 0;
      height: max(1.5rem, env(safe-area-inset-bottom));
    }
  }

  @media (max-width: 560px) {
    :root {
      --nav-logo-h: 72px;
    }

    .nav-logo-img {
      width: auto;
      max-width: none;
      object-position: left center;
    }

    .nav-links {
      width: 100%;
      border-left: 0;
      box-shadow: none;
      padding-left: env(safe-area-inset-left);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-links,
    .nav-scrim,
    .nav-link,
    .dropdown,
    .dropdown a,
    .chevron,
    .site-search-panel,
    .site-search-trigger,
    .site-search-input,
    .hamburger-line,
    .nav-mobile-toggle,
    .nav-dropdown-toggle,
    :global(.site-search-result-btn) {
      transition: none !important;
    }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';
  import { rankSearchItems } from '../lib/search-match';
  import type { SiteSearchItem } from '../lib/site-search';

  const MOBILE_MQ = '(max-width: 1250px)';
  let navController: AbortController | null = null;

  document.addEventListener('astro:page-load', () => {
    navController?.abort();
    navController = new AbortController();
    const { signal } = navController;

    const toggle = document.querySelector('.nav-mobile-toggle') as HTMLButtonElement | null;
    const siteNav = document.querySelector<HTMLElement>('.site-nav');
    const links = document.querySelector<HTMLElement>('#site-nav-links');
    const navScrim = document.querySelector<HTMLElement>('[data-nav-scrim]');
    const docBody = document.body;
    const siteSearch = document.querySelector<HTMLElement>('[data-site-search]');
    const siteSearchTrigger = document.querySelector<HTMLButtonElement>('[data-site-search-trigger]');
    const siteSearchPanel = document.querySelector<HTMLElement>('#site-search-panel');
    const siteSearchInput = document.querySelector<HTMLInputElement>('[data-site-search-input]');
    const siteSearchForm = document.querySelector<HTMLFormElement>('[data-site-search-form]');
    const siteSearchStatus = document.querySelector<HTMLElement>('[data-site-search-status]');
    const siteSearchResults = document.querySelector<HTMLElement>('[data-site-search-results]');
    const siteSearchEmpty = document.querySelector<HTMLElement>('[data-site-search-empty]');
    const siteSearchData = document.querySelector<HTMLScriptElement>('#site-search-data');

    const searchItems: SiteSearchItem[] = JSON.parse(siteSearchData?.textContent || '[]');

    const setMenuState = (open: boolean) => {
      links?.classList.toggle('open', open);
      navScrim?.classList.toggle('is-open', open);
      toggle?.setAttribute('aria-expanded', String(open));
      docBody.classList.toggle('nav-open', open);
      document.querySelectorAll<HTMLElement>('.has-dropdown.is-expanded').forEach((item) => {
        item.classList.remove('is-expanded');
      });
      document
        .querySelectorAll<HTMLButtonElement>('.nav-dropdown-toggle[aria-expanded="true"]')
        .forEach((trigger) => trigger.setAttribute('aria-expanded', 'false'));
    };

    const documentSlug = (href: string) =>
      (href.split(/[?#]/)[0].split('/').pop() ?? '')
        .replace(/\.pdf$/i, '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '')
        .slice(0, 60);

    const createAction = (href: string, label: string, modifier: string) => {
      const action = document.createElement('a');
      action.href = href;
      action.className = `site-search-result-btn ${modifier}`;
      action.textContent = label;
      return action;
    };

    const renderSearchResults = () => {
      if (!siteSearchInput || !siteSearchResults || !siteSearchStatus || !siteSearchEmpty) return;

      const rawQuery = siteSearchInput.value.trim();
      siteSearchResults.replaceChildren();

      if (!rawQuery) {
        siteSearchStatus.textContent = '';
        siteSearchEmpty.hidden = true;
        return;
      }

      const rankedMatches = rankSearchItems(searchItems, rawQuery);
      const matches = rankedMatches.slice(0, 12);
      const fragment = document.createDocumentFragment();

      matches.forEach(({ item }) => {
        const result = document.createElement('li');
        result.className = 'site-search-result';
        const card = document.createElement('div');
        card.className = 'site-search-result-card';
        const info = document.createElement('div');
        info.className = 'site-search-result-info';
        const title = document.createElement('strong');
        title.textContent = item.title;
        const context = document.createElement('span');
        context.className = 'site-search-result-context';
        context.textContent = item.context;
        info.append(title, context);

        if (item.kind === 'page' && item.description) {
          const description = document.createElement('p');
          description.className = 'site-search-result-description';
          description.textContent = item.description;
          info.append(description);
        }

        const actions = document.createElement('div');
        actions.className = 'site-search-result-actions';

        if (item.kind === 'page') {
          actions.append(createAction(item.href, 'Open page', 'site-search-result-btn--open'));
        } else {
          const pageAction = createAction(item.pageHref, 'View on page', 'site-search-result-btn--page');
          const documentAction = createAction(item.href, 'Open document', 'site-search-result-btn--open');
          documentAction.target = '_blank';
          documentAction.rel = 'noopener noreferrer';
          documentAction.setAttribute('data-umami-event', 'pdf-download');
          documentAction.setAttribute('data-umami-event-doc', documentSlug(item.href));
          actions.append(pageAction, documentAction);
        }

        card.append(info, actions);
        result.append(card);
        fragment.append(result);
      });

      siteSearchResults.append(fragment);
      siteSearchEmpty.hidden = matches.length > 0;
      siteSearchStatus.textContent =
        rankedMatches.length > matches.length
          ? `Showing ${matches.length} of ${rankedMatches.length} results.`
          : matches.length === 1
            ? '1 result found.'
            : `${matches.length} results found.`;
    };

    const setSearchState = (open: boolean) => {
      siteSearch?.classList.toggle('is-open', open);
      siteNav?.classList.toggle('has-open-search', open);
      siteSearchTrigger?.setAttribute('aria-expanded', String(open));
      siteSearchPanel?.setAttribute('aria-hidden', String(!open));
      siteSearchPanel?.toggleAttribute('inert', !open);
      if (open) {
        setMenuState(false);
        renderSearchResults();
        window.requestAnimationFrame(() => siteSearchInput?.focus());
      }
    };

    toggle?.addEventListener('click', () => {
      setSearchState(false);
      setMenuState(!(links?.classList.contains('open') ?? false));
    }, { signal });

    navScrim?.addEventListener('click', () => setMenuState(false), { signal });

    siteSearchTrigger?.addEventListener('click', () => {
      setSearchState(!(siteSearch?.classList.contains('is-open') ?? false));
    }, { signal });

    siteSearchInput?.addEventListener('input', renderSearchResults, { signal });

    siteSearchForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      const value = siteSearchInput?.value.trim() ?? '';
      const target = value ? `/search?q=${encodeURIComponent(value)}` : '/search';
      setSearchState(false);
      navigate(target);
    }, { signal });

    document.addEventListener('click', (event) => {
      const target = event.target as Node | null;
      if (!target) return;

      if (siteSearch?.classList.contains('is-open') && !siteSearch.contains(target)) {
        setSearchState(false);
      }

      if (
        links?.classList.contains('open') &&
        !links.contains(target) &&
        !toggle?.contains(target)
      ) {
        setMenuState(false);
      }
    }, { signal });

    links?.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      const mobileMenu = window.matchMedia(MOBILE_MQ).matches;
      const dropdownTrigger = target?.closest<HTMLButtonElement>('[data-dropdown-trigger]');
      if (mobileMenu && dropdownTrigger) {
        event.preventDefault();
        const item = dropdownTrigger.closest<HTMLElement>('.has-dropdown');
        const expanded = !(item?.classList.contains('is-expanded') ?? false);
        item?.classList.toggle('is-expanded', expanded);
        dropdownTrigger.setAttribute('aria-expanded', String(expanded));
        return;
      }
      if (mobileMenu && target?.closest('a')) setMenuState(false);
    }, { signal });

    window.addEventListener('resize', () => {
      if (!window.matchMedia(MOBILE_MQ).matches) setMenuState(false);
    }, { signal });

    window.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;

      if (siteSearch?.classList.contains('is-open')) {
        event.preventDefault();
        setSearchState(false);
        siteSearchTrigger?.focus();
        return;
      }

      if (links?.classList.contains('open')) {
        event.preventDefault();
        setMenuState(false);
        toggle?.focus();
        return;
      }

      document
        .querySelectorAll<HTMLButtonElement>('.nav-dropdown-toggle[aria-expanded="true"]')
        .forEach((trigger) => trigger.setAttribute('aria-expanded', 'false'));
    }, { signal });

    document.querySelectorAll<HTMLElement>('.has-dropdown').forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>(':scope .nav-dropdown-toggle[aria-haspopup="true"]');
      const setExpanded = (expanded: boolean) => {
        if (window.matchMedia(MOBILE_MQ).matches || siteNav?.classList.contains('has-open-search')) {
          trigger?.setAttribute('aria-expanded', 'false');
          return;
        }
        trigger?.setAttribute('aria-expanded', String(expanded));
      };
      item.addEventListener('pointerenter', () => setExpanded(true), { signal });
      item.addEventListener('pointerleave', () => setExpanded(false), { signal });
      item.addEventListener('focusin', () => setExpanded(true), { signal });
      item.addEventListener('focusout', (event) => {
        if (!item.contains(event.relatedTarget as Node | null)) setExpanded(false);
      }, { signal });
    });
  });
</script>
