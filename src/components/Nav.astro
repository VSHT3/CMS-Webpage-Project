        aria-label="Search publications"
        aria-controls="pdf-search-panel"
        aria-expanded="false"
        data-pdf-search-trigger
      >
        <svg class="pdf-search-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="m21 21-4.35-4.35" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"></path>
          <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
        </svg>
        <span>Search Publications</span>
      </button>

      <section
        class="pdf-search-panel"
        id="pdf-search-panel"
        aria-label="Search publications"
        aria-hidden="true"
        inert
      >
        <form class="pdf-search-form" role="search" data-pdf-search-form>
          <label class="pdf-search-label" for="pdf-search-input">Search publications</label>
          <input
            id="pdf-search-input"
            class="pdf-search-input"
            type="search"
            autocomplete="off"
            placeholder="Type a title, report, catalogue, author, or year"
            data-pdf-search-input
          />
        </form>
        <p class="pdf-search-status" aria-live="polite" data-pdf-search-status>
          {pdfSearchItems.length} publications indexed.
        </p>
        <ul class="pdf-search-results" id="pdf-search-results" role="list" data-pdf-search-results></ul>
        <p class="pdf-search-empty" hidden data-pdf-search-empty>No matching publications.</p>
