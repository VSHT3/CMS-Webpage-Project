---
import ClientRouter from 'astro/components/ClientRouter.astro';
import Nav from '../components/Nav.astro';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}

const {
  title = 'Mesoamerica',
  description = 'Center for Mesoamerican Studies, Comenius University Bratislava',
  bodyClass = '',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#183138" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <link rel="icon" href="/assets/LogoTest_ULR2LENFW1uu6krJGVj2C.png" />
    <title>{title}</title>
    <slot name="head" />
    <ClientRouter />
  </head>
  <body class={bodyClass}>
    <Nav transition:persist />
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <img
            src="/assets/LogoTest_ULR2LENFW1uu6krJGVj2C.png"
            alt="CMS Logo"
            width="56"
            height="56"
          />
          <div>
            <span class="footer-wordmark">mesoamerica.eu</span>
            <p>Center for Mesoamerican Studies</p>
          </div>
        </div>
        <address class="footer-address">
          Faculty of Arts, Comenius University Bratislava<br />
          Štúrova 9, 811 02 Bratislava
        </address>
        <nav class="footer-links" aria-label="Footer navigation">
          <a href="/">Home</a>
          <a href="/about-us">About</a>
          <a href="/about-us-contacts">Contact</a>
          <a href="https://fphil.uniba.sk/" target="_blank" rel="noopener">Faculty ↗</a>
        </nav>
        <div class="footer-social">
          <a href="mailto:jakub.spotak@uniba.sk">Email ↗</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  :root {
    --site-bg: oklch(0.2 0.035 205);
    --site-bg-alt: oklch(0.25 0.032 198);
    --site-bg-deep: oklch(0.15 0.022 202);
    --site-surface: oklch(0.24 0.028 198);
    --site-surface-raised: oklch(0.28 0.03 194);
    --site-text: oklch(0.9 0.018 88);
    --site-text-strong: oklch(0.95 0.014 86);
    --site-text-dim: oklch(0.74 0.026 185);
    --site-gold: oklch(0.76 0.08 92);
    --site-teal: oklch(0.68 0.075 178);
    --site-border: oklch(0.43 0.04 190 / 0.62);
    --site-shadow: 0 18px 42px oklch(0.11 0.018 205 / 0.32);
    --site-font: 'Palatino Linotype', Palatino, 'Book Antiqua', Georgia, serif;
    --site-measure: 68ch;
    --site-ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --site-ease-standard: cubic-bezier(0.25, 1, 0.5, 1);
    --site-page-inline: clamp(1rem, 3vw, 2rem);
    --site-z-nav: 40;
    --site-z-nav-panel: 39;
    --site-z-dropdown: 50;
    --site-z-progress: 60;
    background: var(--site-bg);
  }

  :host,
  html {
    background-color: var(--site-bg);
    background-image: linear-gradient(180deg, var(--site-bg) 0%, var(--site-bg-alt) 58%, var(--site-bg-deep) 100%);
    color: var(--site-text);
    font-family: var(--site-font);
    font-size: 16px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    font-kerning: normal;
    text-rendering: optimizeLegibility;
  }

  body {
    margin: 0;
    background-color: var(--site-bg);
    background-image: linear-gradient(180deg, var(--site-bg) 0%, var(--site-bg-alt) 58%, var(--site-bg-deep) 100%);
    min-height: 100vh;
    overflow-x: clip;
  }

  @supports (animation-timeline: scroll()) {
    body::before {
      content: '';
      position: fixed;
      inset: 0 auto auto 0;
      z-index: var(--site-z-progress);
      width: 100%;
      height: 2px;
      pointer-events: none;
      background: linear-gradient(90deg, var(--site-gold), var(--site-teal));
      transform-origin: left center;
      scale: 0 1;
      animation: site-scroll-progress linear both;
      animation-timeline: scroll();
    }
  }

  @keyframes site-scroll-progress {
    to {
      scale: 1 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :host,
    html {
      scroll-behavior: smooth;
    }
  }

  .site-main {
    min-height: 60vh;
    width: 100%;
  }

  a {
    color: var(--site-teal);
    text-decoration: none;
    transition: color 0.18s var(--site-ease-standard);
  }

  a:hover,
  a:focus-visible {
    color: var(--site-gold);
  }

  h1,
  h2,
  h3,
  h4 {
    font-family: 'Palatino Linotype', Palatino, 'Book Antiqua', Georgia, serif;
    color: var(--site-text);
    line-height: 1.18;
    letter-spacing: 0.02em;
    text-wrap: balance;
  }

  p {
    color: var(--site-text);
    margin: 0 0 1.25rem;
    max-width: var(--site-measure);
  }

  b,
  strong {
    color: var(--site-text-strong);
  }

  ::selection {
    background: oklch(0.76 0.08 92 / 0.28);
    color: var(--site-text-strong);
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
    }

    body::before {
      display: none;
      animation: none;
    }
  }
</style>

<style>
  .site-footer {
    background: color-mix(in oklab, var(--site-bg-deep) 88%, oklch(0.1 0.018 205));
    border-top: 1px solid var(--site-border);
    padding: clamp(2rem, 4vw, 2.75rem) 0;
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .footer-inner {
    max-width: 75rem;
    margin: 0 auto;
    padding: 0 var(--site-page-inline);
    display: grid;
    grid-template-columns: minmax(14rem, 1.1fr) minmax(14rem, 0.9fr) minmax(16rem, 1fr) auto;
    align-items: start;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .footer-brand img {
    width: 48px;
    height: 48px;
    object-fit: contain;
    opacity: 0.9;
  }

  .footer-wordmark {
    font-family: 'Palatino Linotype', Palatino, 'Book Antiqua', Georgia, serif;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    color: var(--site-text);
  }

  .footer-brand p,
  .footer-address {
    margin: 0.2rem 0 0;
    color: var(--site-text-dim);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .footer-address {
    font-style: normal;
  }

  .footer-links,
  .footer-social {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer-links a,
  .footer-social a {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-family: 'Palatino Linotype', Palatino, 'Book Antiqua', Georgia, serif;
    color: var(--site-text-dim);
    transition: color 0.18s var(--site-ease-standard);
  }

  .footer-links a:hover,
  .footer-links a:focus-visible,
  .footer-social a:hover,
  .footer-social a:focus-visible {
    color: var(--site-gold);
  }

  .footer-links a:focus-visible,
  .footer-social a:focus-visible {
    outline: 2px solid color-mix(in oklab, var(--site-gold) 76%, var(--site-text-strong));
    outline-offset: 4px;
  }

  .footer-social {
    margin-left: auto;
  }

  @media (max-width: 980px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
    }

    .footer-social {
      margin-left: 0;
    }
  }

  @media (max-width: 720px) {
    .site-footer {
      margin-top: 3rem;
      padding: 2rem 0 2.5rem;
    }

    .footer-inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .footer-social {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
