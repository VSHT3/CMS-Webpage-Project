---
import ClientRouter from 'astro/components/ClientRouter.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  /** Keep a page out of the index — used for legacy pages with no body content. */
  noindex?: boolean;
}

const {
  title = 'Mesoamerica',
  description = 'Center for Mesoamerican Studies, Comenius University Bratislava',
  bodyClass = '',
  noindex = false,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#183138" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="icon" href="/assets/cms-logo.png" />
    <link rel="preload" href="/fonts/source-serif-4-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <slot name="head" />
    {/* GoatCounter: privacy-friendly visit counter, cookieless. */}
    <script is:inline data-goatcounter="https://vsht.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
    {/*
      Umami: self-hosted, cookieless. No consent banner required, the tracker
      writes no cookies and no storage, it only reads its own `umami.disabled`
      opt-out key. Pageviews on client-side navigation need no extra code
      because the tracker hooks history.pushState/replaceState, which Astro's
      ClientRouter calls. Do NOT add `data-astro-rerun` (Astro dedupes scripts
      by src across swaps, so forcing a re-run re-hooks pushState and
      double-counts) and do NOT set `data-auto-track="false"` (that freezes the
      tracker's internal currentUrl on the first page, so every event reports a
      stale URL). These comments are JSX-style on purpose: HTML comments would
      ship this paragraph to every visitor on all 41 pages.
    */}
    <script is:inline defer src="https://analytika.draxtonbrno.cz/script.js" data-website-id="caa68fdd-3442-4b89-9562-1196a4521a39"></script>
    <ClientRouter />
  </head>
  <body class={bodyClass}>
    <Nav />
    <main class="site-main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  /*
    Self-hosted variable fonts. Two subsets each: `latin` carries the Latin-1
    accents (á ä é í ó ô ú ý), `latin-ext` carries the caron/acute letters Slovak
    needs (č ď ĺ ľ ň ŕ š ť ž). Neither subset is sufficient alone — both must be
    declared. Only `latin` is preloaded; `latin-ext` loads on demand via
    unicode-range, so English pages never pay for it.
  */
  @font-face {
    font-family: 'Source Serif 4';
    font-style: normal;
    font-weight: 300 700;
    font-display: swap;
    src: url('/fonts/source-serif-4-latin-ext.woff2') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }

  @font-face {
    font-family: 'Source Serif 4';
    font-style: normal;
    font-weight: 300 700;
    font-display: swap;
    src: url('/fonts/source-serif-4-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'Geist';
    font-style: normal;
    font-weight: 300 600;
    font-display: swap;
    src: url('/fonts/geist-latin-ext.woff2') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }

  @font-face {
    font-family: 'Geist';
    font-style: normal;
    font-weight: 300 600;
    font-display: swap;
    src: url('/fonts/geist-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  /*
    Metric-matched fallbacks. Without these the swap from Georgia/system-ui to
    the real faces reflows every text block. Overrides are tuned to the loaded
    faces so the swap is invisible.
  */
  @font-face {
    font-family: 'Source Serif Fallback';
    src: local('Georgia'), local('Times New Roman'), local('serif');
    size-adjust: 98%;
    ascent-override: 102%;
    descent-override: 32%;
    line-gap-override: 0%;
  }

  @font-face {
    font-family: 'Geist Fallback';
    src: local('Arial'), local('Helvetica'), local('sans-serif');
    size-adjust: 96%;
    ascent-override: 98%;
    descent-override: 24%;
    line-gap-override: 0%;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  :root {
    /* Tonal scale. Additive: --site-surface / --site-surface-raised /
       --site-bg-alt keep their values because the other 36 pages use them. */
    --site-bg-abyss: oklch(0.12 0.02 204);
    --site-bg: oklch(0.19 0.03 204);
    --site-bg-alt: oklch(0.25 0.032 198);
    --site-bg-deep: oklch(0.15 0.022 202);
    --site-bg-raised: oklch(0.24 0.028 198);
    --site-surface: oklch(0.24 0.028 198);
    --site-surface-raised: oklch(0.28 0.03 194);
    --site-text: oklch(0.9 0.018 88);
    --site-text-strong: oklch(0.95 0.014 86);
    --site-text-dim: oklch(0.74 0.026 185);
    --site-gold: oklch(0.76 0.08 92);
    --site-teal: oklch(0.68 0.075 178);
    --site-border: oklch(0.43 0.04 190 / 0.62);
    --site-shadow: 0 18px 42px oklch(0.11 0.018 205 / 0.32);
    --site-font-display: 'Source Serif 4', 'Source Serif Fallback', Georgia, serif;
    --site-font-body: 'Source Serif 4', 'Source Serif Fallback', Georgia, serif;
    --site-font-ui: 'Geist', 'Geist Fallback', system-ui, sans-serif;
    /* Retained alias: legacy pages and Webstudio content still reference it. */
    --site-font: var(--site-font-body);
    --site-measure: 68ch;
    --site-ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --site-ease-standard: cubic-bezier(0.25, 1, 0.5, 1);
    --site-page-inline: clamp(1rem, 3vw, 2rem);
    --site-z-nav: 40;
    --site-z-nav-panel: 39;
    --site-z-dropdown: 50;
    background: var(--site-bg);
  }

  :host,
  html {
    background-color: var(--site-bg-deep);
    background-image: none;
    color: var(--site-text);
    font-family: var(--site-font);
    font-size: 16px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    font-kerning: normal;
    text-rendering: optimizeLegibility;
  }

  body {
    margin: 0;
    background-color: var(--site-bg-deep);
    background-image: none;
    min-height: 100vh;
    overflow-x: clip;
  }


  @media (prefers-reduced-motion: no-preference) {
    :host,
    html {
      scroll-behavior: smooth;
    }
  }

  .site-main {
    min-height: 60vh;
    width: 100%;
  }

  a {
    color: var(--site-teal);
    text-decoration: none;
    transition: color 0.18s var(--site-ease-standard);
  }

  a:hover,
  a:focus-visible {
    color: var(--site-gold);
  }

  h1,
  h2,
  h3,
  h4 {
    font-family: var(--site-font-display);
    color: var(--site-text);
    line-height: 1.18;
    letter-spacing: 0.02em;
    text-wrap: balance;
  }

  p {
    color: var(--site-text);
    margin: 0 0 1.25rem;
    max-width: var(--site-measure);
  }

  b,
  strong {
    color: var(--site-text-strong);
  }

  ::selection {
    background: oklch(0.76 0.08 92 / 0.28);
    color: var(--site-text-strong);
  }

  /* View Transitions: instant out, fast fade-in. Eliminates cross-fade ghost. */
  ::view-transition-old(root) {
    animation: none;
  }

  ::view-transition-new(root) {
    animation: vt-in 160ms var(--site-ease-out) both;
  }

  @keyframes vt-in {
    from { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
    }

    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none;
    }
  }
</style>
