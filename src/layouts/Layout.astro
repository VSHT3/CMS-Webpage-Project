---
import ClientRouter from 'astro/components/ClientRouter.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}

const {
  title = 'Mesoamerica',
  description = 'Center for Mesoamerican Studies, Comenius University Bratislava',
  bodyClass = '',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#183138" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <link rel="icon" href="/assets/cms-logo.png" />
    <title>{title}</title>
    <slot name="head" />
    <!-- GoatCounter — privacy-friendly visit counter -->
    <script is:inline data-goatcounter="https://vsht.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
    <!-- Umami — self-hosted, cookieless. No consent banner required: the tracker
         writes no cookies and no storage, it only reads its own `umami.disabled`
         opt-out key. Pageviews on client-side navigation need no extra code
         because the tracker hooks history.pushState/replaceState, which Astro's
         ClientRouter calls. Do NOT add `data-astro-rerun` (Astro dedupes scripts
         by src across swaps; forcing a re-run re-hooks pushState and double-counts)
         and do NOT set `data-auto-track="false"` (that freezes the tracker's
         internal currentUrl on the first page, so every event reports a stale URL). -->
    <script is:inline defer src="https://analytika.draxtonbrno.cz/script.js" data-website-id="caa68fdd-3442-4b89-9562-1196a4521a39"></script>
    <ClientRouter />
  </head>
  <body class={bodyClass}>
    <Nav />
    <main class="site-main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  :root {
    --site-bg: oklch(0.2 0.035 205);
    --site-bg-alt: oklch(0.25 0.032 198);
    --site-bg-deep: oklch(0.15 0.022 202);
    --site-surface: oklch(0.24 0.028 198);
    --site-surface-raised: oklch(0.28 0.03 194);
    --site-text: oklch(0.9 0.018 88);
    --site-text-strong: oklch(0.95 0.014 86);
    --site-text-dim: oklch(0.74 0.026 185);
    --site-gold: oklch(0.76 0.08 92);
    --site-teal: oklch(0.68 0.075 178);
    --site-border: oklch(0.43 0.04 190 / 0.62);
    --site-shadow: 0 18px 42px oklch(0.11 0.018 205 / 0.32);
    --site-font: 'Palatino Linotype', Palatino, 'Book Antiqua', Georgia, serif;
    --site-measure: 68ch;
    --site-ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --site-ease-standard: cubic-bezier(0.25, 1, 0.5, 1);
    --site-page-inline: clamp(1rem, 3vw, 2rem);
    --site-z-nav: 40;
    --site-z-nav-panel: 39;
    --site-z-dropdown: 50;
    background: var(--site-bg);
  }

  :host,
  html {
    background-color: var(--site-bg);
    background-image: linear-gradient(180deg, var(--site-bg) 0%, var(--site-bg-alt) 58%, var(--site-bg-deep) 100%);
    color: var(--site-text);
    font-family: var(--site-font);
    font-size: 16px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    font-kerning: normal;
    text-rendering: optimizeLegibility;
  }

  body {
    margin: 0;
    background-color: var(--site-bg);
    background-image: linear-gradient(180deg, var(--site-bg) 0%, var(--site-bg-alt) 58%, var(--site-bg-deep) 100%);
    min-height: 100vh;
    overflow-x: clip;
  }


  @media (prefers-reduced-motion: no-preference) {
    :host,
    html {
      scroll-behavior: smooth;
    }
  }

  .site-main {
    min-height: 60vh;
    width: 100%;
  }

  a {
    color: var(--site-teal);
    text-decoration: none;
    transition: color 0.18s var(--site-ease-standard);
  }

  a:hover,
  a:focus-visible {
    color: var(--site-gold);
  }

  h1,
  h2,
  h3,
  h4 {
    font-family: 'Palatino Linotype', Palatino, 'Book Antiqua', Georgia, serif;
    color: var(--site-text);
    line-height: 1.18;
    letter-spacing: 0.02em;
    text-wrap: balance;
  }

  p {
    color: var(--site-text);
    margin: 0 0 1.25rem;
    max-width: var(--site-measure);
  }

  b,
  strong {
    color: var(--site-text-strong);
  }

  ::selection {
    background: oklch(0.76 0.08 92 / 0.28);
    color: var(--site-text-strong);
  }

  /* View Transitions: instant out, fast fade-in. Eliminates cross-fade ghost. */
  ::view-transition-old(root) {
    animation: none;
  }

  ::view-transition-new(root) {
    animation: vt-in 160ms var(--site-ease-out) both;
  }

  @keyframes vt-in {
    from { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
    }

    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none;
    }
  }
</style>
