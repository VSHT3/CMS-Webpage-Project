---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import Nav from '../components/Nav.astro';

const { source } = Astro.props;
const raw = readFileSync(resolve('.', source), 'utf-8');

const headContent = raw.match(/<head[^>]*>([\s\S]*?)<\/head>/i)?.[1] ?? '';
const bodyContent = raw.match(/<body[^>]*>([\s\S]*?)<\/body>/i)?.[1] ?? '';
---
<!doctype html>
<html lang="en">
  <head>
    <Fragment set:html={headContent} />
  </head>
  <body>
    <Nav />
    <style is:global>
      .Mobile,
      .Computer,
      .BigComputer {
        display: none !important;
      }
    </style>
    <Fragment set:html={bodyContent} />
  </body>
</html>
