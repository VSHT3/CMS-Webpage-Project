---
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { parse, renderSync } from 'ultrahtml';
import Layout from './Layout.astro';
import { rewriteLegacyAssetUrl } from '../lib/legacy-pdf-map';

const { source } = Astro.props;
const raw = readFileSync(resolve('.', source), 'utf-8').replaceAll('Uxactun', 'Uaxactun');

const title =
  raw.match(/<title[^>]*>([\s\S]*?)<\/title>/i)?.[1]?.replace(/\s+/g, ' ').trim() ??
  'Mesoamerica';

const description =
  raw.match(/<meta[^>]+name=["']description["'][^>]+content=["']([^"']*)["'][^>]*>/i)?.[1] ??
  'Center for Mesoamerican Studies, Comenius University Bratislava';

const preloadLinks = '';
const pageSlug = source.match(/legacy\/source-html\/([^/]+)\//)?.[1] ?? 'legacy-page';

type LegacyNode = {
  type: number;
  name?: string;
  value?: string;
  attributes?: Record<string, string>;
  children?: LegacyNode[];
};
type LegacyElement = LegacyNode & { type: 1; name: string; attributes?: Record<string, string>; children?: LegacyNode[] };
type LegacyText = LegacyNode & { type: 2; value?: string };

const VOID_TAGS = new Set(['br', 'hr', 'img']);
const BLOCKED_TAGS = new Set([
  'script',
  'style',
  'noscript',
  'link',
  'meta',
  'svg',
  'path',
  'button',
  'nav',
  'form',
  'input',
  'textarea',
  'select',
  'option',
  'label',
]);
const CONTENT_TAGS = new Set([
  'h1',
  'h2',
  'h3',
  'h4',
  'h5',
  'h6',
  'p',
  'section',
  'article',
  'ul',
  'ol',
  'li',
  'a',
  'img',
  'iframe',
  'figure',
  'figcaption',
  'blockquote',
  'hr',
]);
const ATTR_WHITELIST: Record<string, Set<string>> = {
  a: new Set(['href', 'target', 'download', 'rel']),
  img: new Set(['src', 'alt', 'loading', 'decoding', 'width', 'height']),
  iframe: new Set(['src', 'title', 'allow', 'allowfullscreen', 'loading', 'referrerpolicy']),
};

const bodyMatch = raw.match(/<body[^>]*>([\s\S]*?)<\/body>/i);
const bodyHtml = bodyMatch ? bodyMatch[1] : raw;
const bodyTree = parse(bodyHtml);

const escapeHtml = (value: string) =>
  value.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');

const escapeAttribute = (value: string) =>
  escapeHtml(value).replaceAll('"', '&quot;').replaceAll("'", '&#39;');

const decodeEntities = (value: string) => {
  let output = value;

  for (let index = 0; index < 3; index += 1) {
    const next = output
      .replaceAll('&amp;', '&')
      .replaceAll('&quot;', '"')
      .replaceAll('&#39;', "'")
      .replaceAll('&lt;', '<')
      .replaceAll('&gt;', '>')
      .replaceAll('&nbsp;', ' ');

    if (next === output) {
      break;
    }

    output = next;
  }

  return output;
};

const isElement = (node?: LegacyNode | null): node is LegacyElement =>
  Boolean(node && node.type === 1 && node.name);
const isText = (node?: LegacyNode | null): node is LegacyText => Boolean(node && node.type === 2);

const getClassName = (node: LegacyNode) => node.attributes?.class ?? '';
const serializeNode = (node: LegacyNode) => renderSync(node as never);

const hasContentTag = (node: LegacyNode): boolean => {
  if (isElement(node) && CONTENT_TAGS.has(node.name?.toLowerCase() ?? '')) {
    return true;
  }

  return (node.children ?? []).some(hasContentTag);
};

const isLegacyHeaderNode = (node: LegacyNode) => {
  const html = serializeNode(node);
  return /\bMobile\b|\bComputer\b|\bBigComputer\b/.test(html);
};

const isLegacyFooterNode = (node: LegacyNode) => {
  const html = serializeNode(node);
  return html.includes('mesoamerica.eu') && html.includes('/#home-btn');
};

const isScaffoldNode = (node: LegacyNode) => {
  if (!isElement(node)) {
    return false;
  }

  const tag = node.name?.toLowerCase() ?? '';
  if (BLOCKED_TAGS.has(tag)) {
    return true;
  }

  if (tag === 'div' && !hasContentTag(node) && !isLegacyHeaderNode(node) && !isLegacyFooterNode(node)) {
    return true;
  }

  return false;
};

const topLevelNodes = ((bodyTree.children ?? []) as LegacyNode[]).filter(
  (node: LegacyNode) => isElement(node) || (isText(node) && node.value?.trim()),
);

const contentNodes: LegacyNode[] = [];
let contentStarted = false;

for (const node of topLevelNodes) {
  if (isText(node)) {
    if (contentStarted && node.value?.trim()) {
      contentNodes.push(node);
    }
    continue;
  }

  if (isLegacyHeaderNode(node) || isScaffoldNode(node)) {
    continue;
  }

  if (isLegacyFooterNode(node)) {
    break;
  }

  if (hasContentTag(node)) {
    contentStarted = true;
  }

  if (contentStarted) {
    contentNodes.push(node);
  }
}

const renderAttrs = (tag: string, attrs: Record<string, string> = {}) => {
  const allowed = ATTR_WHITELIST[tag];
  if (!allowed) {
    return '';
  }

  const rendered: string[] = [];

  for (const [name, rawValue] of Object.entries(attrs)) {
    const attr = name.toLowerCase();
    if (!allowed.has(attr)) {
      continue;
    }

    const decoded = decodeEntities(rawValue).trim();
    if (!decoded) {
      continue;
    }

    const value = (attr === 'href' || attr === 'src') ? rewriteLegacyAssetUrl(decoded) : decoded;

    if (
      tag === 'iframe' &&
      (attr === 'allowfullscreen' || attr === 'mozallowfullscreen' || attr === 'webkitallowfullscreen')
    ) {
      if (!rendered.includes('allowfullscreen')) {
        rendered.push('allowfullscreen');
      }
      continue;
    }

    rendered.push(`${attr}="${escapeAttribute(value)}"`);
  }

  if (tag === 'a') {
    const hasTargetBlank = rendered.some((attr) => attr === 'target="_blank"');
    const hasRel = rendered.some((attr) => attr.startsWith('rel="'));
    if (hasTargetBlank && !hasRel) {
      rendered.push('rel="noopener noreferrer"');
    }
  }

  return rendered.length ? ` ${rendered.join(' ')}` : '';
};

const getAssetName = (src = '') => {
  const normalized = decodeEntities(src).trim();
  if (!normalized.startsWith('/assets/')) {
    return '';
  }

  return normalized.split('/').pop() ?? '';
};

const getOptimizedBase = (src = '') => {
  const assetName = getAssetName(src);
  if (!assetName) {
    return '';
  }

  return assetName.replace(/\.[^.]+$/, '').replace(/[^a-zA-Z0-9_-]+/g, '-');
};

const getOptimizedImageSrcset = (src = '') => {
  const base = getOptimizedBase(src);
  if (!base) {
    return '';
  }

  const candidates = [720, 1200, 1800].map((width) => ({
    width,
    url: `/assets/optimized/${base}-${width}.webp`,
  }));

  const hasAllCandidates = candidates.every((candidate) => existsSync(resolve('.', `public${candidate.url}`)));
  if (!hasAllCandidates) {
    return '';
  }

  return candidates.map((candidate) => `${candidate.url} ${candidate.width}w`).join(', ');
};

const getMediaAlt = (src = '') => {
  const assetName = getAssetName(src);

  if (/logo|cms_cu|header_logo/i.test(assetName)) {
    return 'Center for Mesoamerican Studies mark';
  }

  if (/petnal|uaxactun|maya|artefact|artifact|emc|moja_cesta|20211115|image/i.test(assetName)) {
    return `${title} visual material`;
  }

  return `${title} image`;
};

const renderImageAttrs = (attrs: Record<string, string> = {}) => {
  const imgAttrs = { ...attrs };

  if (!decodeEntities(imgAttrs.alt ?? '').trim()) {
    imgAttrs.alt = getMediaAlt(imgAttrs.src);
  }

  imgAttrs.loading ??= 'lazy';
  imgAttrs.decoding ??= 'async';

  return renderAttrs('img', imgAttrs);
};

const renderExternalEmbed = (attrs: Record<string, string> = {}) => {
  const iframeAttrs = { ...attrs };
  const src = decodeEntities(iframeAttrs.src ?? '').trim();
  if (!src) {
    return '';
  }

  const isMapEmbed = /(?:google\.com\/maps|maps\.google)/i.test(src);

  if (!decodeEntities(iframeAttrs.title ?? '').trim()) {
    iframeAttrs.title = isMapEmbed ? `${title} map` : `${title} embedded content`;
  }

  iframeAttrs.loading ??= 'lazy';
  iframeAttrs.referrerpolicy ??= 'strict-origin-when-cross-origin';
  iframeAttrs.src = src;

  if (isMapEmbed) {
    return `<iframe${renderAttrs('iframe', iframeAttrs)}></iframe>`;
  }

  return `<div class="legacy-embed" data-embed-src="${escapeAttribute(src)}" data-embed-title="${escapeAttribute(iframeAttrs.title)}" data-embed-allow="${escapeAttribute(iframeAttrs.allow ?? '')}" data-embed-allowfullscreen="${iframeAttrs.allowfullscreen != null ? 'true' : ''}">
    <div>
      <strong>${escapeHtml(iframeAttrs.title)}</strong>
      <p>External interactive content is available on request.</p>
    </div>
    <button type="button" class="legacy-embed-button">Load embedded content</button>
  </div>`;
};

const renderChildren = (node: LegacyNode) =>
  (node.children ?? [])
    .map((child) => renderCleanNode(child))
    .join('')
    .replace(/\s{3,}/g, '  ');

const renderWrapper = (html: string) => {
  const trimmed = html.trim();
  if (!trimmed) {
    return '';
  }

  const itemCount =
    (trimmed.match(/<(h[1-6]|p|ul|ol|li|a|img|iframe|figure|figcaption|blockquote|hr|section)\b/gi) ??
      []).length;

  if (itemCount <= 1) {
    return trimmed;
  }

  return `<section>${trimmed}</section>`;
};

let renderedPrimaryHeading = false;
const usedHeadingIds = new Set<string>();

const makeHeadingId = (html: string) => {
  const base = html
    .replace(/<[^>]+>/g, '')
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
  if (!base) return '';
  let id = base;
  let n = 2;
  while (usedHeadingIds.has(id)) id = `${base}-${n++}`;
  usedHeadingIds.add(id);
  return id;
};

const renderCleanNode = (node: LegacyNode): string => {
  if (node.type === 3 || node.type === 4) {
    return '';
  }

  if (isText(node)) {
    const value = decodeEntities(node.value ?? '');
    if (value.trim() === '|') {
      return '<span class="legacy-inline-sep" aria-hidden="true"></span>';
    }
    return escapeHtml(value);
  }

  if (!isElement(node)) {
    return '';
  }

  const tag = node.name?.toLowerCase() ?? '';
  if (!tag || BLOCKED_TAGS.has(tag)) {
    return '';
  }

  const className = getClassName(node);
  if (className.includes('w-html-embed')) {
    return renderWrapper(renderChildren(node));
  }

  const children = renderChildren(node).trim();

  if (tag === 'br') {
    return '<br>';
  }

  if (tag === 'hr') {
    return '<hr>';
  }

  if (tag === 'img') {
    const src = node.attributes?.src;
    if (!src) {
      return '';
    }

    const srcset = getOptimizedImageSrcset(src);
    const imageAttrs = { ...node.attributes };

    if (srcset) {
      imageAttrs.src = `/assets/optimized/${getOptimizedBase(src)}-1200.webp`;
      const attrs = renderImageAttrs(imageAttrs);
      return `<picture><source type="image/webp" srcset="${escapeAttribute(srcset)}" sizes="(max-width: 760px) calc(100vw - 2rem), min(100vw, 74rem)"><img${attrs}></picture>`;
    }

    const attrs = renderImageAttrs(imageAttrs);
    return `<img${attrs}>`;
  }

  if (tag === 'iframe') {
    return renderExternalEmbed(node.attributes);
  }

  if (tag === 'a') {
    const attrs = renderAttrs('a', node.attributes);
    if (!node.attributes?.href) {
      return children;
    }
    return `<a${attrs}>${children}</a>`;
  }

  if (['strong', 'b', 'em', 'i'].includes(tag)) {
    return children ? `<${tag}>${children}</${tag}>` : '';
  }

  if (CONTENT_TAGS.has(tag)) {
    if (!children && !VOID_TAGS.has(tag)) {
      return '';
    }

    if (tag === 'h1') {
      if (renderedPrimaryHeading) {
        const id = makeHeadingId(children);
        return `<h2${id ? ` id="${escapeAttribute(id)}"` : ''}>${children}</h2>`;
      }
      renderedPrimaryHeading = true;
      return `<h1>${children}</h1>`;
    }

    if (/^h[2-6]$/.test(tag)) {
      const id = makeHeadingId(children);
      return `<${tag}${id ? ` id="${escapeAttribute(id)}"` : ''}>${children}</${tag}>`;
    }

    return `<${tag}>${children}</${tag}>`;
  }

  if (tag === 'div' || tag === 'span') {
    return renderWrapper(children);
  }

  return children;
};

const cleanedBody = contentNodes
  .map((node) => renderCleanNode(node))
  .join('\n')
  .replace(/&amp;([a-z0-9#]+;)/gi, '&$1')
  .replace(/<\/a>\s*\|\s*<a/gi, '</a><span class="legacy-inline-sep" aria-hidden="true"></span><a')
  .replace(/<section>\s*<\/section>/gi, '')
  .replace(/<p>\s*<\/p>/gi, '')
  .replace(/\s*<section>\s*(<h1[\s\S]*?<\/h1>|<hr>)\s*<\/section>\s*/gi, '\n$1\n')
  .replace(/\s*<section>\s*(<h2[\s\S]*?<\/h2>|<hr>)\s*<\/section>\s*/gi, '\n$1\n')
  .replace(/(<\/(h1|h2|h3|h4|h5|h6|p|ul|ol|li|section|figure|blockquote)>)(?=<)/gi, '$1\n')
  .replace(/(<hr>)(?=<)/gi, '$1\n')
  .replace(/(<p>[^<]*?)(<a[^>]+\bdownload="[^"]+"[^>]*>\s*Download PDF\s*<\/a>)\s*<\/p>/gi, '$1</p>\n$2')
  .replace(
    /(<h3>CATALOGUE OF CERAMICS OF REGIONAL PROJECT UAXACTUN 2009-2019<\/h3>\s*<p>Compiled by Jakub Špoták<\/p>)\s*<hr>\s*(<a[^>]+Spotak_Catalog_ceramics_2023_online\.pdf[^>]*>\s*Download PDF\s*<\/a>)/i,
    '$1\n$2\n<hr>',
  )
  .replace(/\n{3,}/g, '\n\n')
  .trim();

// 17 of the 31 migrated Webstudio pages were never written — their source
// carries a heading and an `<hr>` and nothing else (all of Education and
// Collections, the Ferdinand Anders Library, and four of the six PARU Uaxactun
// pages). Publishing them as indexable thin content hurts the whole domain, so
// emptiness is derived from the extracted body rather than a hardcoded list:
// the moment real content is authored upstream, the page indexes itself again.
//
// Media counts as content — `paru-uaxactun-gallery` is four images and no prose,
// which is a real page.
const MEDIA_CONTENT = /<(img|picture|iframe|video|audio|table|li)\b/i;
const bodyProse = cleanedBody
  .replace(/<h[1-6][^>]*>[\s\S]*?<\/h[1-6]>/gi, '')
  .replace(/<hr\s*\/?>/gi, '')
  .replace(/<[^>]+>/g, '')
  .trim();
const hasRealContent = bodyProse.length > 0 || MEDIA_CONTENT.test(cleanedBody);
---
<Layout title={title} description={description} bodyClass="legacy-page" noindex={!hasRealContent}>
  <Fragment slot="head" set:html={preloadLinks} />

  <section class="legacy-page-shell">
    <article class="legacy-page-content" data-page-slug={pageSlug}>
      <Fragment set:html={cleanedBody} />
      {
        !hasRealContent && (
          <aside class="legacy-page-pending">
            <p class="legacy-page-pending-lead">This section is being prepared.</p>
            <p>
              Its material has not been published on the site yet. For current work, see{' '}
              <a href="/research">Research</a> or <a href="/publications">Publications</a>, or{' '}
              <a href="/about-us-contacts">contact the Center</a>.
            </p>
          </aside>
        )
      }
    </article>
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('.legacy-embed').forEach((embed) => {
    const button = embed.querySelector<HTMLButtonElement>('.legacy-embed-button');

    button?.addEventListener('click', () => {
      const src = embed.dataset.embedSrc;
      if (!src) {
        return;
      }

      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = embed.dataset.embedTitle || 'Embedded content';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';

      const allow = embed.dataset.embedAllow;
      if (allow) {
        iframe.setAttribute('allow', allow);
      }

      if (embed.dataset.embedAllowfullscreen === 'true') {
        iframe.setAttribute('allowfullscreen', '');
      }

      embed.replaceChildren(iframe);
    });
  });

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const revealTargets = document.querySelectorAll<HTMLElement>(
    '.legacy-page-content > section:not(:first-child), .legacy-page-content > h2, .legacy-page-content > h3',
  );

  if (!reduceMotion && revealTargets.length > 0 && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.12 },
    );

    revealTargets.forEach((target) => {
      target.classList.add('legacy-scroll-reveal');
      observer.observe(target);
    });
  }
</script>

<style is:global>
  body.legacy-page {
    background: linear-gradient(180deg, var(--site-bg) 0%, var(--site-bg-alt) 42%, var(--site-bg-deep) 100%);
  }

  .legacy-page-shell {
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 3vw, 1.5rem) 0;
  }

  .legacy-page-content {
    width: min(100%, 74rem);
    margin: 0 auto;
    display: grid;
    gap: clamp(1.2rem, 2.4vw, 2rem);
    color: var(--site-text);
  }

  .legacy-page-content > * {
    min-width: 0;
  }

  .legacy-page-content > :first-child {
    background: none;
    border: 0;
    box-shadow: none;
    padding: 0;
  }

  .legacy-page-content > :first-child h1 {
    margin: 0;
    max-width: 18ch;
    font-size: clamp(2.35rem, 6vw, 4.35rem);
    line-height: 1.02;
    letter-spacing: 0.02em;
    text-wrap: balance;
  }

  .legacy-page-content > :first-child hr {
    margin: 0;
  }

  .legacy-page-content > *:not(:first-child) {
    border-top: 1px solid var(--site-border);
    padding-top: clamp(1.1rem, 2.4vw, 1.8rem);
  }

  /* Shown on pages whose legacy source carries a heading and nothing else, so a
     visitor who follows the nav there gets a straight answer instead of a blank
     page. These pages are also `noindex` — see `hasRealContent` above. */
  .legacy-page-pending {
    display: grid;
    gap: 0.6rem;
    max-width: var(--site-measure);
  }

  .legacy-page-pending p {
    margin: 0;
    color: var(--site-text-dim);
    line-height: 1.82;
    text-wrap: pretty;
  }

  .legacy-page-pending-lead {
    font-family: var(--site-font);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    letter-spacing: 0.03em;
    color: var(--site-text);
  }

  /* Inline links across the site reveal their underline only on hover. These
     three are the sole way off an otherwise empty page, so they carry it at
     rest — without changing that convention anywhere else. Scoped through
     `.legacy-page-content` to outrank the equal-specificity `a` rule declared
     further down this sheet. */
  .legacy-page-content .legacy-page-pending a {
    background-size: 100% 1px;
    color: var(--site-text);
  }

  .legacy-page-content h1,
  .legacy-page-content h2,
  .legacy-page-content h3,
  .legacy-page-content h4 {
    margin: 0;
    font-family: 'Palatino Linotype', Palatino, 'Book Antiqua', Georgia, serif;
    color: var(--site-text);
    text-wrap: balance;
  }

  .legacy-page-content h2 {
    font-size: clamp(1.35rem, 3vw, 1.9rem);
    letter-spacing: 0.04em;
  }

  .legacy-page-content h3 {
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    letter-spacing: 0.03em;
  }

  .legacy-page-content p,
  .legacy-page-content li {
    color: var(--site-text-dim);
    line-height: 1.82;
    text-wrap: pretty;
  }

  .legacy-page-content p:last-child,
  .legacy-page-content li:last-child,
  .legacy-page-content ul:last-child,
  .legacy-page-content ol:last-child {
    margin-bottom: 0;
  }

  .legacy-page-content section {
    display: grid;
    gap: 0.95rem;
  }

  .legacy-page-content section:has(> picture + picture),
  .legacy-page-content section:has(> img + img) {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    align-items: start;
  }

  .legacy-page-content[data-page-slug='events'] {
    width: min(100%, 68rem);
    gap: clamp(1rem, 2vw, 1.6rem);
  }

  .legacy-page-content[data-page-slug='events'] > :first-child h1 {
    max-width: 12ch;
  }

  .legacy-page-content[data-page-slug='events'] > section:not(:first-child) h1 {
    max-width: 24ch;
    font-size: clamp(1.65rem, 3.6vw, 2.7rem);
    line-height: 1.08;
    letter-spacing: 0.015em;
  }

  .legacy-page-content[data-page-slug='events'] section {
    gap: 0.7rem;
  }

  .legacy-page-content[data-page-slug='events'] > section:not(:first-child) > section {
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .legacy-page-content[data-page-slug='events'] > section:not(:first-child) > section > h2:first-child {
    max-width: 28ch;
    margin-bottom: 0.25rem;
    font-size: clamp(1.65rem, 3.4vw, 2.6rem);
    line-height: 1.08;
    letter-spacing: 0.015em;
    color: var(--site-text);
  }

  .legacy-page-content[data-page-slug='events'] > section:not(:first-child) > section > section:has(> h2) {
    gap: 0.5rem;
    padding-top: clamp(0.95rem, 2vw, 1.35rem);
    border-top: 1px solid color-mix(in oklab, var(--site-border) 76%, transparent);
  }

  .legacy-page-content[data-page-slug='events'] > section:not(:first-child) > section > section > h2 {
    max-width: 42ch;
    font-size: clamp(1.08rem, 1.6vw, 1.28rem);
    line-height: 1.22;
    letter-spacing: 0.025em;
    color: var(--site-text-strong);
  }

  .legacy-page-content[data-page-slug='events'] p {
    max-width: 74ch;
    margin: 0;
    font-size: 1rem;
    line-height: 1.62;
  }

  .legacy-page-content[data-page-slug='events'] p strong {
    display: inline-block;
    min-width: 10.5rem;
    margin-right: 0.35rem;
